+  if (client_rects_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'client_rects_fp' configuration...";
+
+    absl::optional<bool> cr_enabled =
+        client_rects_fp_dict->FindBool("enabled");
+    client_rects_config_.enabled = cr_enabled.value_or(false);
+
+    absl::optional<int> cr_seed =
+        client_rects_fp_dict->FindInt("seed");
+    if (cr_seed.has_value()) {
+      client_rects_config_.seed = cr_seed.value();
+    }
+
+    client_rects_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] ClientRects config: enabled="
+              << client_rects_config_.enabled
+              << ", seed=" << client_rects_config_.seed;
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'client_rects_fp' config found, "
+                 "ClientRects noise disabled";
+    client_rects_config_.enabled = false;
+    client_rects_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse screen_fp configuration
+  // Overrides screen.width/height/availWidth/availHeight/colorDepth
+  // and matchMedia device-width/device-height.
+  // ============================================================
+  const base::DictValue* screen_fp_dict =
+      root_dict.FindDict("screen_fp");
+  if (screen_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'screen_fp' configuration...";
+
+    absl::optional<bool> sc_enabled =
+        screen_fp_dict->FindBool("enabled");
+    screen_config_.enabled = sc_enabled.value_or(false);
+
+    absl::optional<int> sc_width = screen_fp_dict->FindInt("width");
+    if (sc_width.has_value() && sc_width.value() > 0)
+      screen_config_.width = sc_width.value();
+
+    absl::optional<int> sc_height = screen_fp_dict->FindInt("height");
+    if (sc_height.has_value() && sc_height.value() > 0)
+      screen_config_.height = sc_height.value();
+
+    absl::optional<int> sc_avail_w = screen_fp_dict->FindInt("avail_width");
+    if (sc_avail_w.has_value() && sc_avail_w.value() > 0)
+      screen_config_.avail_width = sc_avail_w.value();
+
+    absl::optional<int> sc_avail_h = screen_fp_dict->FindInt("avail_height");
+    if (sc_avail_h.has_value() && sc_avail_h.value() > 0)
+      screen_config_.avail_height = sc_avail_h.value();
+
+    absl::optional<int> sc_depth = screen_fp_dict->FindInt("color_depth");
+    if (sc_depth.has_value() && sc_depth.value() > 0)
+      screen_config_.color_depth = sc_depth.value();
+
+    // avail_width/avail_height: if not manually configured (0),
+    // fall through to browser's real calculation in screen.cc.
+    // No hardcoded auto-compute here.
+
+    screen_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] Screen config: enabled="
+              << screen_config_.enabled
+              << ", width=" << screen_config_.width
+              << ", height=" << screen_config_.height
+              << ", avail_width=" << screen_config_.avail_width
+              << ", avail_height=" << screen_config_.avail_height
+              << ", color_depth=" << screen_config_.color_depth;
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'screen_fp' config found, "
+                 "screen override disabled";
+    screen_config_.enabled = false;
+    screen_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse webgpu_fp configuration
+  // Overrides adapter.features, device.limits, adapter.info.
+  // ============================================================
+  const base::DictValue* webgpu_fp_dict =
+      root_dict.FindDict("webgpu_fp");
+  if (webgpu_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'webgpu_fp' configuration...";
+
+    absl::optional<bool> wg_enabled =
+        webgpu_fp_dict->FindBool("enabled");
+    webgpu_config_.enabled = wg_enabled.value_or(false);
+
+    absl::optional<int> wg_seed = webgpu_fp_dict->FindInt("seed");
+    if (wg_seed.has_value())
+      webgpu_config_.seed = wg_seed.value();
+
+    const std::string* wg_vendor = webgpu_fp_dict->FindString("vendor");
+    if (wg_vendor && !wg_vendor->empty())
+      webgpu_config_.vendor = String::FromUtf8(wg_vendor->c_str());
+
+    const std::string* wg_arch = webgpu_fp_dict->FindString("architecture");
+    if (wg_arch && !wg_arch->empty())
+      webgpu_config_.architecture = String::FromUtf8(wg_arch->c_str());
+
+    webgpu_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] WebGPU config: enabled="
+              << webgpu_config_.enabled
+              << ", seed=" << webgpu_config_.seed
+              << ", vendor=" << webgpu_config_.vendor
+              << ", architecture=" << webgpu_config_.architecture;
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'webgpu_fp' config found, "
+                 "WebGPU override disabled";
+    webgpu_config_.enabled = false;
+    webgpu_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse voices_fp configuration
+  // Overrides speechSynthesis.getVoices() voice list.
+  // ============================================================
+  const base::DictValue* voices_fp_dict =
+      root_dict.FindDict("voices_fp");
+  if (voices_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'voices_fp' configuration...";
+
+    absl::optional<bool> v_enabled =
+        voices_fp_dict->FindBool("enabled");
+    voices_config_.enabled = v_enabled.value_or(false);
+
+    const base::ListValue* voices_list =
+        voices_fp_dict->FindList("voices");
+    if (voices_list) {
+      voices_config_.voices.clear();
+      for (const auto& item : *voices_list) {
+        if (!item.is_dict())
+          continue;
+        const base::DictValue& v = item.GetDict();
+        VoiceEntry entry;
+
+        const std::string* name = v.FindString("name");
+        if (name)
+          entry.name = String::FromUtf8(name->c_str());
+
+        const std::string* lang = v.FindString("lang");
+        if (lang)
+          entry.lang = String::FromUtf8(lang->c_str());
+
+        // Support both "voice_uri" (legacy) and "voiceURI" (browser format)
+        const std::string* uri = v.FindString("voice_uri");
+        if (!uri)
+          uri = v.FindString("voiceURI");
+        if (uri)
+          entry.voice_uri = String::FromUtf8(uri->c_str());
+        else
+          entry.voice_uri = entry.name;  // default: use name as URI
+
+        // Support both "local_service" (legacy) and "localService" (browser format)
+        entry.local_service =
+            v.FindBool("local_service").value_or(
+                v.FindBool("localService").value_or(true));
+
+        // Support both "is_default" (legacy) and "default" (browser format)
+        entry.is_default =
+            v.FindBool("is_default").value_or(
+                v.FindBool("default").value_or(false));
+
+        if (!entry.name.empty())
+          voices_config_.voices.push_back(entry);
+      }
+    }
+
+    voices_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] Voices config: enabled="
+              << voices_config_.enabled
+              << ", voices_count="
+              << voices_config_.voices.size();
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'voices_fp' config found, "
+                 "voices override disabled";
+    voices_config_.enabled = false;
+    voices_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse geolocation_fp configuration
+  // Overrides navigator.geolocation.getCurrentPosition/watchPosition.
+  // mode: "custom" = return configured position,
+  //       "disabled" = always return permission denied.
+  // ============================================================
+  const base::DictValue* geolocation_fp_dict =
+      root_dict.FindDict("geolocation_fp");
+  if (geolocation_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'geolocation_fp' configuration...";
+
+    absl::optional<bool> geo_enabled =
+        geolocation_fp_dict->FindBool("enabled");
+    geolocation_config_.enabled = geo_enabled.value_or(false);
+
+    const std::string* mode = geolocation_fp_dict->FindString("mode");
+    if (mode && !mode->empty())
+      geolocation_config_.mode = String::FromUtf8(mode->c_str());
+    else
+      geolocation_config_.mode = "custom";  // default
+
+    absl::optional<double> lat = geolocation_fp_dict->FindDouble("latitude");
+    if (lat.has_value())
+      geolocation_config_.latitude = lat.value();
+
+    absl::optional<double> lon = geolocation_fp_dict->FindDouble("longitude");
+    if (lon.has_value())
+      geolocation_config_.longitude = lon.value();
+
+    absl::optional<double> acc = geolocation_fp_dict->FindDouble("accuracy");
+    if (acc.has_value())
+      geolocation_config_.accuracy = acc.value();
+
+    geolocation_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] Geolocation config: enabled="
+              << geolocation_config_.enabled
+              << ", mode=" << geolocation_config_.mode
+              << ", lat=" << geolocation_config_.latitude
+              << ", lon=" << geolocation_config_.longitude
+              << ", accuracy=" << geolocation_config_.accuracy;
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'geolocation_fp' config found, "
+                 "geolocation override disabled";
+    geolocation_config_.enabled = false;
+    geolocation_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse do_not_track_fp configuration
+  // Overrides navigator.doNotTrack and HTTP DNT header.
+  // ============================================================
+  const base::DictValue* dnt_fp_dict =
+      root_dict.FindDict("do_not_track_fp");
+  if (dnt_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'do_not_track_fp' configuration...";
+
+    absl::optional<bool> dnt_enabled =
+        dnt_fp_dict->FindBool("enabled");
+    do_not_track_config_.enabled = dnt_enabled.value_or(false);
+
+    absl::optional<bool> dnt_value = dnt_fp_dict->FindBool("value");
+    if (dnt_value.has_value())
+      do_not_track_config_.value = dnt_value.value();
+
+    do_not_track_config_.is_valid = true;
+    LOG(INFO) << "[Fingerprint-DEBUG] DoNotTrack config: enabled="
+              << do_not_track_config_.enabled
+              << ", value=" << do_not_track_config_.value;
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'do_not_track_fp' config found, "
+                 "doNotTrack override disabled";
+    do_not_track_config_.enabled = false;
+    do_not_track_config_.is_valid = false;
+  }
+
+  // ============================================================
+  // ★ Parse cdp_fp configuration (CDP / DevTools detection evasion)
+  // When enabled, suppresses all console.* output reporting to DevTools
+  // by setting the --console_output_disabled V8 flag, so pages cannot
+  // detect an attached DevTools via console.* side effects.
+  // ============================================================
+  const base::DictValue* cdp_fp_dict = root_dict.FindDict("cdp_fp");
+  if (cdp_fp_dict) {
+    absl::optional<bool> cdp_enabled = cdp_fp_dict->FindBool("enabled");
+    if (cdp_enabled.value_or(false)) {
+      // NOTE: console_output_disabled is set via --js-flags passed from the
+      // Browser process (render_process_host_impl.cc), NOT via
+      // SetFlagsFromString here — V8 freezes flag memory after init, so a
+      // runtime SetFlagsFromString would crash the renderer.
+      LOG(INFO) << "[Fingerprint] CDP detection evasion ENABLED "
+                   "(set via --js-flags=--console_output_disabled)";
+    } else {
+      LOG(INFO) << "[Fingerprint] CDP detection evasion disabled (cdp_fp)";
+    }
+  } else {
+    LOG(INFO) << "[Fingerprint] No 'cdp_fp' config found, CDP evasion disabled";
+  }
+
+  LOG(INFO) << "[Fingerprint-DEBUG] ✅ Config parsed successfully!";
+  return true;
+}
