+
+scoped_refptr<DrainableIOBuffer> SOCKS5ClientSocket::BuildAuthWriteBuffer()
+    const {
+  // RFC 1929 username/password authentication request:
+  //   +----+------+----------+------+----------+
+  //   |VER | ULEN |  UNAME   | PLEN |  PASSWD  |
+  //   | 1  |  1   | 1 to 255 |  1   | 1 to 255 |
+  //   +----+------+----------+------+----------+
+  std::string username_utf8 = base::UTF16ToUTF8(username_);
+  std::string password_utf8 = base::UTF16ToUTF8(password_);
+
+  std::vector<uint8_t> auth;
+  auth.reserve(3 + username_utf8.size() + password_utf8.size());
+  auth.push_back(0x01);  // Version of the auth subnegotiation.
+  auth.push_back(base::checked_cast<uint8_t>(username_utf8.size()));
+  auth.insert(auth.end(), username_utf8.begin(), username_utf8.end());
+  auth.push_back(base::checked_cast<uint8_t>(password_utf8.size()));
+  auth.insert(auth.end(), password_utf8.begin(), password_utf8.end());
+
+  auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(auth));
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                 base_buffer->size());
+}
+
+// Writes the RFC 1929 username/password authentication request.
+int SOCKS5ClientSocket::DoAuthWrite() {
+  // ULEN and PLEN are single bytes, so both must fit in 255 bytes.
+  if (base::UTF16ToUTF8(username_).size() > 0xFF ||
+      base::UTF16ToUTF8(password_).size() > 0xFF) {
+    net_log_.AddEvent(NetLogEventType::SOCKS_UNEXPECTED_AUTH);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+
+  if (!write_buf_) {
+    write_buf_ = BuildAuthWriteBuffer();
+  }
+
+  return transport_socket_->Write(write_buf_.get(),
+                                  write_buf_->BytesRemaining(), io_callback_,
+                                  traffic_annotation_);
+}
+
+int SOCKS5ClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0)
+    return result;
+
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_AUTH_READ;
+  } else {
+    next_state_ = STATE_AUTH_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5ClientSocket::DoAuthRead() {
+  next_state_ = STATE_AUTH_READ_COMPLETE;
+
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    // The auth response is 2 bytes: version and status.
+    read_buf_->SetCapacity(2);
+  }
+
+  return transport_socket_->Read(read_buf_.get(),
+                                 read_buf_->RemainingCapacity(), io_callback_);
+}
+
+int SOCKS5ClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0)
+    return result;
+
+  // The underlying socket closed unexpectedly.
+  if (result == 0) {
+    net_log_.AddEvent(
+        NetLogEventType::SOCKS_UNEXPECTEDLY_CLOSED_DURING_GREETING);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_AUTH_READ;
+    return OK;
+  }
+
+  base::span<uint8_t> read_data = read_buf_->span_before_offset();
+
+  // read_data[0] is the subnegotiation version (0x01), read_data[1] is the
+  // status; 0x00 means success.
   if (read_data[1] != 0x00) {
     net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_UNEXPECTED_AUTH,
-                                   "method", read_data[1]);
+                                   "status", read_data[1]);
     return ERR_SOCKS_CONNECTION_FAILED;
   }
 
