+namespace {
+
+// 判断 SDP 行尾 token 是否是需要处理的地址（IPv4/IPv6/mDNS 主机名），
+// 排除常见的占位/回环地址。
+bool IsMaskableSdpAddress(const String& token) {
+  if (token.empty()) {
+    return false;
+  }
+  if (token == "0.0.0.0" || token == "127.0.0.1" || token == "::" ||
+      token == "::1") {
+    return false;
+  }
+  if (token.contains(':')) {
+    return true;  // IPv6
+  }
+  if (token.ends_with(".local")) {
+    return true;  // mDNS hostname
+  }
+  if (token.contains('.') && token[0] >= '0' && token[0] <= '9') {
+    return true;  // IPv4
+  }
+  return false;
+}
+
+String JoinTokensWithSpace(const Vector<String>& tokens) {
+  StringBuilder builder;
+  for (unsigned i = 0; i < tokens.size(); ++i) {
+    if (i > 0) {
+      builder.Append(' ');
+    }
+    builder.Append(tokens[i]);
+  }
+  return builder.ToString();
+}
+
+// 处理 c= / o= / a=rtcp: 这类"最后一个 token 是地址"的 SDP 行。
+String SanitizeSdpAddressLine(const String& line, const WebRTCConfig& config) {
+  Vector<String> tokens = line.SplitSkippingEmpty(' ');
+  if (tokens.empty()) {
+    return line;
+  }
+  String& address = tokens.back();
+  if (!IsMaskableSdpAddress(address)) {
+    return line;
+  }
+  if (config.mode == WebRTCMode::kMask) {
+    address = config.ip;
+  } else {  // kBlock
+    address = line.contains("IP6") ? "::" : "0.0.0.0";
+  }
+  return JoinTokensWithSpace(tokens);
+}
+
+}  // namespace
+
+String FingerprintManager::SanitizeWebRTCIceCandidate(
+    const String& candidate) const {
+  WebRTCConfig config = GetWebRTCConfig();
+  if (!config.enabled || !config.is_valid || config.mode == WebRTCMode::kOff ||
+      candidate.empty()) {
+    return candidate;
+  }
+
+  // candidate 格式（RFC 8839）：
+  // candidate:<foundation> <component> <transport> <priority>
+  //           <connection-address> <port> typ <type> [raddr <addr> rport ...]
+  Vector<String> tokens = candidate.SplitSkippingEmpty(' ');
+  if (tokens.size() < 6) {
+    return candidate;  // 格式异常，保持原样
+  }
+
+  // 找到 "typ" 后面的候选类型（host/srflx/prflx/relay）
+  String candidate_type;
+  for (unsigned i = 0; i + 1 < tokens.size(); ++i) {
+    if (tokens[i] == "typ") {
+      candidate_type = tokens[i + 1];
+      break;
+    }
+  }
+
+  if (config.mode == WebRTCMode::kBlock) {
+    // block 模式：丢弃所有 candidate（host/srflx/prflx/relay）。
+    // relay(TURN) 的地址/raddr 同样会暴露本机真实公网 IP——STUN/TURN 走 UDP
+    // 直连、不经过 HTTP 代理，TURN 服务器看到的就是真实 IP。保留 relay 仍会
+    // 泄露真实位置（browserscan 的 TURN 探测即利用此），故一并丢弃。
+    return String();
+  }
+
+  // kMask：用正则把 candidate 字符串中所有 IPv4 替换为配置的 IP。
+  // 比 tokens[4] 字段替换更彻底：覆盖 connection-address、related-address
+  // 以及字符串中任何位置的 IPv4。
+  std::regex ipv4_pattern(
+      R"((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.)"
+      R"((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.)"
+      R"((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.)"
+      R"((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9]))");
+  std::string result =
+      std::regex_replace(candidate.Utf8(), ipv4_pattern, config.ip.Utf8());
+  return String::FromUtf8(result);
+}
+
+String FingerprintManager::SanitizeWebRTCSdp(const String& sdp) const {
+  WebRTCConfig config = GetWebRTCConfig();
+  LOG(INFO) << "[WebRTC-FP] SanitizeWebRTCSdp in_len=" << sdp.length()
+            << " en=" << config.enabled << " mode=" << (int)config.mode
+            << " crlf=" << sdp.contains("\r\n")
+            << " mapp=" << sdp.contains("m=application");
+  if (!config.enabled || !config.is_valid || config.mode == WebRTCMode::kOff ||
+      sdp.empty()) {
+    return sdp;
+  }
+
+  Vector<String> lines = sdp.Split(String("\r\n"));
+  LOG(INFO) << "[WebRTC-FP] SanitizeWebRTCSdp split_lines=" << lines.size();
+
+  StringBuilder builder;
+  bool first = true;
+  for (const String& line : lines) {
+    if (line.empty()) {
+      continue;
+    }
+    String out_line;
+    if (line.starts_with("a=candidate:")) {
+      String rewritten = SanitizeWebRTCIceCandidate(line.substr(2));
+      if (rewritten.empty()) {
+        continue;  // block 模式：删除该候选行
+      }
+      out_line = String("a=") + rewritten;
+    } else if (line.starts_with("c=") || line.starts_with("o=") ||
+               line.starts_with("a=rtcp:")) {
+      out_line = SanitizeSdpAddressLine(line, config);
+    } else {
+      out_line = line;
+    }
+    if (!first) {
+      builder.Append("\r\n");
+    }
+    builder.Append(out_line);
+    first = false;
+  }
+  // ★ 关键修复：保留 SDP 末尾的 \r\n。Split("\r\n") 会丢弃末尾换行，而
+  // webrtc 的 SdpDeserializer 要求每行（含最后一行）以 \r\n 结尾，否则
+  // 最后一行（如 a=max-message-size）会被判为 "Invalid SDP line"。
+  if (sdp.ends_with("\r\n")) {
+    builder.Append("\r\n");
+  }
+  String result = builder.ToString();
+  LOG(INFO) << "[WebRTC-FP] SanitizeWebRTCSdp out_len=" << result.length()
+            << " out_mapp=" << result.contains("m=application")
+            << " end_crlf=" << result.ends_with("\r\n");
+  return result;
+}
