+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_SSL_NETWORK_PERSONA_H_
+#define NET_SSL_NETWORK_PERSONA_H_
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// "network persona" 让 TLS ClientHello 中随版本变化的字段匹配一个声称的
+// Chromium 主版本号，而非本二进制实际编译的版本。由启动开关
+// `--fingerprint-tls-profile=<value>` 驱动，在 network-service 进程（net/ssl
+// 所在进程）读取。
+//
+// 这是一致性优先（coherence-first），而非任意伪造：只交换不同真实 Chromium
+// 主版本之间确实不同的字段（post-quantum key-share 组、ALPS codepoint、ECH
+// GREASE 有无）。确定性的信封（cipher list、版本边界、签名算法、ALPN）以及
+// 每连接扩展排列严格保持原版 Chromium 不变。
+//
+// 取值语法：
+//   "chrome-<major>"   如 "chrome-154"、"chrome-149" -> 版本覆盖
+//   缺省 / "" / "off" / "native" / "auto" / "match-persona" -> 不覆盖
+// 声称的主版本号等于本构建自身的主版本号时也是 no-op（与原版逐字节一致）。
+struct NET_EXPORT NetworkPersonaPlan {
+  // 如何为声称的主版本号塑造 post-quantum key-share 组。
+  enum PqMode {
+    // 声称版本与本构建使用同一 PQ 组（X25519MLKEM768），无需组/key_share 覆盖。
+    kNative,
+    // 声称版本（~124..130）早于 ML-KEM：使用 X25519Kyber768Draft00。
+    kKyber,
+    // 声称版本（<124）早于默认开启 PQ：完全不发送 PQ 组（仅经典组+经典 key_share）。
+    kNone,
+  };
+
+  // 为 true 表示请求了具体、非 native 的 "chrome-<major>" 覆盖。
+  // 为 false 时调用方必须保持原版 ClientHello 不变。
+  bool active = false;
+
+  // 声称的 Chromium 主版本号（仅 active 时有意义）。
+  int major = 0;
+
+  // 要应用的 post-quantum 塑造方式（仅 active 时有意义）。
+  PqMode pq = kNative;
+
+  // 声称版本是否以新 codepoint（0x44CD，~131+）发送 ALPS 扩展，
+  // 而非旧 codepoint（0x4469，更老版本）。
+  bool alps_new_codepoint = true;
+
+  // 声称版本是否发送 ECH GREASE 扩展。
+  bool ech_grease = true;
+};
+
+// 从当前进程命令行（`--fingerprint-tls-profile`）计算 network persona plan。
+// 开销小、无副作用，每个 socket 调用一次是安全的。未请求覆盖时返回 inactive plan。
+NET_EXPORT NetworkPersonaPlan ComputeNetworkPersona();
+
+}  // namespace net
+
+#endif  // NET_SSL_NETWORK_PERSONA_H_
