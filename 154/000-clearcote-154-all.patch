+      payload_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!claims || !claims->is_dict()) {
+    LOG(ERROR) << "[Fingerprint] JWT validation failed: bad payload JSON";
+    return false;
+  }
+  const auto& claim_dict = claims->GetDict();
+  const std::optional<double> iat = claim_dict.FindDouble("iat");
+  const std::optional<double> exp = claim_dict.FindDouble("exp");
