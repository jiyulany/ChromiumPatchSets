@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_PROXY_RESOLUTION_PROXY_CREDENTIALS_STORE_H_
+#define NET_PROXY_RESOLUTION_PROXY_CREDENTIALS_STORE_H_
+
+#include <map>
+#include <string>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "net/base/net_export.h"
+
+namespace net {
+
+// ============================================================
+// Global store for proxy credentials extracted from the
+// --proxy-server command line switch (e.g.
+//   --proxy-server="http://user:pass@host:port")
+//
+// Chromium's --proxy-server parser strips/ignores the userinfo
+// portion, so proxy auth (HTTP 407) would normally fall back to
+// the interactive login dialog. This store keeps the credentials
+// so HttpAuthController can use them automatically.
+//
+// Key format: lowercase "host:port" (e.g. "42.179.217.145:40028")
+// ============================================================
+class NET_EXPORT ProxyCredentialsStore {
+ public:
+  static ProxyCredentialsStore* GetInstance();
+
+  // Parses a full --proxy-server switch value (which may contain multiple
+  // ';'-separated rules), extracts and stores any embedded "user:pass@"
+  // credentials, and returns the value with the userinfo portions removed.
+  // Handles forms like "http://user:pass@host:port",
+  // "socks5://user:pass@host:port" and "scheme=user:pass@host:port".
+  static std::string ParseAndStoreFromProxyServerValue(
+      const std::string& proxy_server_value);
+
+  // Store credentials for a proxy identified by "host:port".
+  void SetCredentials(const std::string& host_port,
+                      const std::u16string& username,
+                      const std::u16string& password);
+
+  // Retrieve credentials for a proxy identified by "host:port".
+  // Returns true if credentials were found.
+  bool GetCredentials(const std::string& host_port,
+                      std::u16string* username,
+                      std::u16string* password) const;
+
+  // Check if any credentials are stored.
+  bool HasCredentials() const;
+
+ private:
+  friend class base::NoDestructor<ProxyCredentialsStore>;
+
+  ProxyCredentialsStore();
+  ~ProxyCredentialsStore();
+
+  // Lazily parses the --proxy-server command line switch of the current
+  // process and stores any embedded credentials. Needed because proxy auth
+  // (HTTP 407 handling and the SOCKS5 handshake) runs in the network
+  // service process, where SetCredentials() was never called.
+  void EnsureCommandLineCredentialsLoaded() const;
+
+  // Does the work for ParseAndStoreFromProxyServerValue(). |lock_| must be
+  // held by the caller.
+  std::string ParseAndStoreLocked(const std::string& proxy_server_value) const;
+
+  mutable base::Lock lock_;
+  // Maps lowercase "host:port" -> (username, password)
+  mutable std::map<std::string, std::pair<std::u16string, std::u16string>>
+      credentials_map_;
+  mutable bool tried_load_from_command_line_ = false;
+};
+
+}  // namespace net
+
+#endif  // NET_PROXY_RESOLUTION_PROXY_CREDENTIALS_STORE_H_
