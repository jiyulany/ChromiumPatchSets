+++ b/net/proxy_resolution/proxy_credentials_store.cc
@@ -0,0 +1,191 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/proxy_resolution/proxy_credentials_store.h"
+
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace net {
+
+namespace {
+
+// Same value as content's switches::kProxyServer, redefined here because
+// //net cannot depend on //content.
+constexpr char kProxyServerSwitchName[] = "proxy-server";
+
+// Credentials extracted from a single proxy rule.
+struct ParsedRuleCredentials {
+  std::string host_port_key;  // lowercase "host:port"
+  std::u16string username;
+  std::u16string password;
+};
+
+// Extracts "user:pass@" credentials from a single proxy rule. Returns the
+// rule without the userinfo portion and fills |out| on success. Handles
+// forms like:
+//   "http://user:pass@host:port"   ->  "http://host:port"
+//   "socks5://user:pass@host:port" ->  "socks5://host:port"
+//   "user:pass@host:port"          ->  "host:port"
+std::string CleanProxyRule(const std::string& rule,
+                           ParsedRuleCredentials* out) {
+  // Find '@' separating userinfo from host. Use rfind because the password
+  // itself may legally contain '@' (the host portion cannot).
+  size_t at_pos = rule.rfind('@');
+  if (at_pos == std::string::npos) {
+    return rule;  // No userinfo present.
+  }
+
+  // Determine where userinfo starts: after "scheme://" if present.
+  std::string prefix;
+  size_t userinfo_start = 0;
+  size_t scheme_pos = rule.find("://");
+  if (scheme_pos != std::string::npos && scheme_pos + 3 <= at_pos) {
+    userinfo_start = scheme_pos + 3;
+    prefix = rule.substr(0, userinfo_start);  // keep "scheme://"
+  }
+
+  std::string userinfo = rule.substr(userinfo_start, at_pos - userinfo_start);
+  size_t colon_pos = userinfo.find(':');
+  if (colon_pos == std::string::npos) {
+    return rule;  // userinfo without password separator; not credentials.
+  }
+
+  std::u16string username = base::UTF8ToUTF16(userinfo.substr(0, colon_pos));
+  std::u16string password = base::UTF8ToUTF16(userinfo.substr(colon_pos + 1));
+
+  // host:port is everything after '@', up to any path.
+  std::string host_port = rule.substr(at_pos + 1);
+  size_t slash_pos = host_port.find('/');
+  if (slash_pos != std::string::npos) {
+    host_port = host_port.substr(0, slash_pos);
+  }
+
+  if (host_port.empty() || username.empty()) {
+    return rule;
+  }
+
+  // Store with lowercase host:port key to match GURL normalization at the
+  // lookup sites (HttpAuthController uses GURL::host(), which lowercases).
+  out->host_port_key = base::ToLowerASCII(host_port);
+  out->username = std::move(username);
+  out->password = std::move(password);
+
+  return prefix + host_port;
+}
+
+}  // namespace
+
+// static
+ProxyCredentialsStore* ProxyCredentialsStore::GetInstance() {
+  static base::NoDestructor<ProxyCredentialsStore> instance;
+  return instance.get();
+}
+
+ProxyCredentialsStore::ProxyCredentialsStore() = default;
+
+ProxyCredentialsStore::~ProxyCredentialsStore() = default;
+
+// static
+std::string ProxyCredentialsStore::ParseAndStoreFromProxyServerValue(
+    const std::string& proxy_server_value) {
+  ProxyCredentialsStore* store = GetInstance();
+  base::AutoLock auto_lock(store->lock_);
+  return store->ParseAndStoreLocked(proxy_server_value);
+}
+
+std::string ProxyCredentialsStore::ParseAndStoreLocked(
+    const std::string& proxy_server_value) const {
+  if (proxy_server_value.find('@') == std::string::npos) {
+    return proxy_server_value;  // Fast path: no userinfo anywhere.
+  }
+
+  std::vector<std::string> rules = base::SplitString(
+      proxy_server_value, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  for (std::string& rule : rules) {
+    ParsedRuleCredentials parsed;
+    // Handle optional "scheme=" prefix (e.g. "http=user:pass@host:port").
+    size_t eq_pos = rule.find('=');
+    if (eq_pos != std::string::npos &&
+        rule.find("://") == std::string::npos) {
+      std::string scheme_prefix = rule.substr(0, eq_pos + 1);
+      rule = scheme_prefix + CleanProxyRule(rule.substr(eq_pos + 1), &parsed);
+    } else {
+      rule = CleanProxyRule(rule, &parsed);
+    }
+    if (!parsed.host_port_key.empty()) {
+      credentials_map_[parsed.host_port_key] =
+          std::make_pair(parsed.username, parsed.password);
+      LOG(INFO) << "[ProxyAuth] Stored credentials for proxy: "
+                << parsed.host_port_key
+                << " (username length: " << parsed.username.length() << ")";
+    }
+  }
+
+  return base::JoinString(rules, ";");
+}
+
+void ProxyCredentialsStore::EnsureCommandLineCredentialsLoaded() const {
+  base::AutoLock auto_lock(lock_);
+  if (tried_load_from_command_line_) {
+    return;
+  }
+  tried_load_from_command_line_ = true;
+
+  // Proxy auth (HTTP 407 handling and the SOCKS5 handshake) runs in the
+  // network service process. SetCredentials() is only called in the browser
+  // process, so parse the --proxy-server switch (which is propagated to the
+  // network service process) directly here.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kProxyServerSwitchName)) {
+    return;
+  }
+  std::string proxy_server =
+      command_line->GetSwitchValueASCII(kProxyServerSwitchName);
+  if (proxy_server.empty() ||
+      proxy_server.find('@') == std::string::npos) {
+    return;
+  }
+
+  LOG(INFO) << "[ProxyAuth] Loading proxy credentials from --proxy-server "
+               "switch in this process";
+  ParseAndStoreLocked(proxy_server);
+}
+
+void ProxyCredentialsStore::SetCredentials(const std::string& host_port,
+                                           const std::u16string& username,
+                                           const std::u16string& password) {
+  base::AutoLock auto_lock(lock_);
+  credentials_map_[host_port] = std::make_pair(username, password);
+  LOG(INFO) << "[ProxyAuth] Stored credentials for proxy: " << host_port
+            << " (username length: " << username.length() << ")";
+}
+
+bool ProxyCredentialsStore::GetCredentials(const std::string& host_port,
+                                           std::u16string* username,
+                                           std::u16string* password) const {
+  EnsureCommandLineCredentialsLoaded();
+  base::AutoLock auto_lock(lock_);
+  auto it = credentials_map_.find(host_port);
+  if (it == credentials_map_.end()) {
+    return false;
+  }
+  *username = it->second.first;
+  *password = it->second.second;
+  return true;
+}
+
+bool ProxyCredentialsStore::HasCredentials() const {
+  EnsureCommandLineCredentialsLoaded();
+  base::AutoLock auto_lock(lock_);
+  return !credentials_map_.empty();
+}
+
+}  // namespace net
