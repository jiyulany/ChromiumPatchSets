+bool FingerprintManager::ShouldHideFont(const String& font_name) const {
+  base::AutoLock auto_lock(lock_);
+
+  // Auto-trigger lazy initialization
+  if (!initialized_) {
+    const_cast<FingerprintManager*>(this)->LazyInitialize();
+  }
+
+  if (!font_config_.enabled || !font_config_.is_valid) {
+    return false;
+  }
+
+  // Check exact match in remove_fonts list
+  for (const String& remove_font : font_config_.remove_fonts) {
+    if (font_name.contains(remove_font)) {
+      LOG(INFO) << "[Font-FP] Hiding font (exact match): " << font_name;
+      return true;
+    }
+  }
+
+  // Probabilistic hiding based on seed
+  if (font_config_.remove_probability > 0.0f) {
+    // Generate deterministic hash from font name and seed
+    uint32_t hash = font_config_.seed;
+    String lower_name = font_name.ToAsciiLower();
+    for (unsigned i = 0; i < lower_name.length(); i++) {
+      hash = hash * 31 + lower_name[i];
+    }
+    
+    // Use hash to determine if font should be hidden
+    float threshold = (hash % 1000) / 1000.0f;
+    bool should_hide = threshold < font_config_.remove_probability;
+    
+    if (should_hide) {
+      LOG(INFO) << "[Font-FP] Hiding font (probabilistic, threshold=" 
+                << threshold << " < " << font_config_.remove_probability 
+                << "): " << font_name;
+    }
+    
+    return should_hide;
+  }
+
+  return false;
+}
+
+// GetCanvasHash: internal helper - assumes caller already holds lock_
+// WARNING: Do NOT call this from outside a locked context!
+uint32_t FingerprintManager::GetCanvasHash(unsigned width, 
+                                                  unsigned height) const {
+  // NOTE: No lock here! Caller must hold lock_ to avoid deadlock
+  if (!initialized_ || !canvas_config_.enabled || canvas_config_.noise_seed == 0) {
+    return 0;
+  }
+  
+  // Create a hash from canvas dimensions combined with the seed
+  // This ensures different canvas sizes get different but consistent noise
+  DeterministicPRNG prng(canvas_config_.noise_seed);
+  uint32_t w_hash = prng.Next() ^ (width * 2654435761u);
+  uint32_t h_hash = prng.Next() ^ (height * 2654435761u);
+  
+  DeterministicPRNG final_prng(w_hash ^ h_hash);
+  return final_prng.Next();
+}
+
+String FingerprintManager::ApplyNoiseToDataURL(const String& data_url,
+                                                     unsigned width,
+                                                     unsigned height) const {
+  LOG(INFO) << "[Fingerprint-DEBUG] ===== ApplyNoiseToDataURL() called =====";
+  LOG(INFO) << "[Fingerprint-DEBUG] Input dataURL length: " << data_url.length();
+  LOG(INFO) << "[Fingerprint-DEBUG] Canvas size: " << width << "x" << height;
+  
+  base::AutoLock auto_lock(lock_);
+  
+  // Check if randomization is enabled
+  if (!initialized_ || !canvas_config_.enabled || canvas_config_.noise_intensity <= 0) {
+    LOG(WARNING) << "[Fingerprint-DEBUG] ⚠️ Noise NOT applied! initialized=" 
+                 << initialized_ << ", enabled=" << canvas_config_.enabled 
+                 << ", intensity=" << canvas_config_.noise_intensity;
+    LOG(WARNING) << "[Fingerprint-DEBUG] Returning ORIGINAL dataURL unchanged!";
+    return data_url;
+  }
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] ✅ Applying noise with seed=" 
+            << canvas_config_.noise_seed << ", intensity=" << canvas_config_.noise_intensity;
+  
+  // Only modify image data URLs, not empty ones
+  if (!data_url.starts_with("data:image/") || data_url.length() < 30) {
+    return data_url;
+  }
+  
+  // Find the Base64 part (after the comma)
+  int comma_index = data_url.find(',');
+  if (comma_index == -1) {
+    return data_url;
+  }
+  
+  // Split into header and base64 data
+  String header = data_url.substr(0, comma_index + 1);
+  String base64_data = data_url.substr(comma_index + 1);
+  
+  // Calculate expected data size based on dimensions and format
+  // For PNG: typically ~width*height*4 bytes before encoding
+  size_t estimated_pixels = static_cast<size_t>(width) * height;
+  size_t estimated_data_size = estimated_pixels * 4; // RGBA
+  
+  // Apply noise to the Base64 data
+  String modified_base64 = InjectNoiseIntoBase64(
+      base64_data, 
+      estimated_data_size,
+      width,
+      height);
+  
+  StringBuilder result;
+  result.Append(header);
+  result.Append(modified_base64);
+  return result.ToString();
+}
+
+uint8_t FingerprintManager::GenerateNoiseByte(size_t position) const {
+  if (canvas_config_.noise_seed == 0 || !canvas_config_.enabled) {
+    return 0;
+  }
+  
+  // Use position as part of seed for position-dependent noise
+  DeterministicPRNG prng(canvas_config_.noise_seed ^ static_cast<uint32_t>(position));
+  prng.Next(); // Skip first iteration
+  
+  // Scale noise by intensity level (1-10)
+  // Lower intensity = smaller changes, higher intensity = more noticeable changes
+  int base_noise = prng.Next(255 / (11 - canvas_config_.noise_intensity));
+  
+  // Occasionally skip modification based on intensity (lower intensity = more skips)
+  if (canvas_config_.noise_intensity < 5) {
+    // Fixed: explicit type conversion to avoid sign-comparison warning
+    uint32_t threshold = static_cast<uint32_t>(canvas_config_.noise_intensity * 2);
+    if (prng.Next(10) >= threshold) {
+      return 0; // No change for this position
+    }
+  }
+  
+  return static_cast<uint8_t>(base_noise);
+}
+
+String FingerprintManager::InjectNoiseIntoBase64(const String& base64_data,
+                                                        size_t data_length,
+                                                        unsigned width,
+                                                        unsigned height) const {
+  // CORRECTED STRATEGY: Decode PNG -> Decompress IDAT -> Modify raw pixels -> Recompress
+  // This ensures only individual pixels change by ±1~±2, keeping image visually identical
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] InjectNoiseIntoBase64() called (pixel-level method)";
+  LOG(INFO) << "[Fingerprint-DEBUG] Input base64 length: " << base64_data.length();
+  
+  if (data_length == 0 || width == 0 || height == 0) {
+    LOG(WARNING) << "[Fingerprint-DEBUG] Invalid dimensions, returning original";
+    return base64_data;
+  }
+  
+  std::string base64_str = base64_data.Utf8();
+  
+  // Step 1: Decode Base64 to binary PNG data
+  std::vector<uint8_t> png_data = Base64Decode(base64_str);
+  
+  if (png_data.size() < 100) {
+    LOG(WARNING) << "[Fingerprint-DEBUG] PNG data too small (" 
+                 << png_data.size() << " bytes), returning original";
+    return base64_data;
+  }
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] Decoded PNG size: " << png_data.size() << " bytes";
+  
+  // Step 2: Locate ALL IDAT chunks and collect compressed data
+  // IMPORTANT: Some PNGs split image data across multiple IDAT chunks!
+  size_t data_start = 8;  // Skip PNG signature
+  std::vector<uint8_t> idat_combined_data;  // Combined data from all IDAT chunks
+  size_t idat_start_offset = 0;  // Where first IDAT chunk begins (for PNG rebuild)
+  size_t idat_total_size = 0;    // Total size of all IDAT data + headers
+
+  while (data_start + 12 <= png_data.size()) {
+    uint32_t chunk_len = (static_cast<uint32_t>(png_data[data_start]) << 24) |
+                         (static_cast<uint32_t>(png_data[data_start + 1]) << 16) |
+                         (static_cast<uint32_t>(png_data[data_start + 2]) << 8) |
+                         static_cast<uint32_t>(png_data[data_start + 3]);
+
+    char type[4] = {static_cast<char>(png_data[data_start + 4]),
+                    static_cast<char>(png_data[data_start + 5]),
+                    static_cast<char>(png_data[data_start + 6]),
+                    static_cast<char>(png_data[data_start + 7])};
+
+    bool is_idat = (type[0] == 'I' && type[1] == 'D' && type[2] == 'A' && type[3] == 'T');
+    bool is_iend = (type[0] == 'I' && type[1] == 'E' && type[2] == 'N' && type[3] == 'D');
+
+    if (is_idat && chunk_len > 0 && data_start + 12 + chunk_len <= png_data.size()) {
+      // Remember where first IDAT starts
+      if (idat_combined_data.empty()) {
+        idat_start_offset = data_start;
+      }
+      // Append this IDAT's data to combined buffer
+      size_t data_offset = data_start + 8;  // After length(4) + type(4)
+      idat_combined_data.insert(idat_combined_data.end(),
+                                png_data.begin() + data_offset,
+                                png_data.begin() + data_offset + chunk_len);
+      // Track total IDAT chunk size (length field + type + data + CRC)
+      idat_total_size += 12 + chunk_len;
+    }
+
+    data_start += 12 + chunk_len;
+
+    if (is_iend || data_start >= png_data.size()) break;
+  }
+
+  if (idat_combined_data.empty()) {
+    LOG(WARNING) << "[Fingerprint-DEBUG] No IDAT chunks found, returning original";
+    return base64_data;
+  }
+
+  LOG(INFO) << "[Fingerprint-DEBUG] Collected " << idat_combined_data.size()
+            << " bytes of IDAT data, first at offset " << idat_start_offset;
+
+  // Step 3: Decompress IDAT data using zlib inflate
+  std::vector<uint8_t> raw_pixels;
+
+  z_stream strm;
+  memset(&strm, 0, sizeof(strm));
+  strm.next_in = idat_combined_data.data();
+  strm.avail_in = static_cast<uInt>(idat_combined_data.size());
+
+  // Use inflateInit2 with window bits that handle both zlib and raw deflate
+  int init_ret = inflateInit2(&strm, MAX_WBITS | 32);  // Auto-detect gzip/zlib header
+  if (init_ret != Z_OK) {
+    LOG(ERROR) << "[Fingerprint-DEBUG] zlib inflateInit2 failed, error: " << init_ret;
+    return base64_data;
+  }
+
+  // Decompress into growing buffer - start generous and grow as needed
+  size_t out_capacity = std::max(static_cast<size_t>(width * height * 4 + height),
+                                  static_cast<size_t>(65536));  // At least 64KB
+  raw_pixels.resize(out_capacity);
+  strm.next_out = raw_pixels.data();
+  strm.avail_out = static_cast<uInt>(raw_pixels.size());
+
+  int ret = Z_OK;
+  while (ret != Z_STREAM_END) {
+    ret = inflate(&strm, Z_NO_FLUSH);
+
+    if (ret == Z_BUF_ERROR || ret == Z_OK) {
+      // Need more output space or continue processing
+      if (strm.avail_out == 0 || ret == Z_BUF_ERROR) {
+        size_t current_size = raw_pixels.size();
+        raw_pixels.resize(current_size * 2);
+        strm.next_out = &raw_pixels.at(current_size);  // Safe: bounds-checked
+        strm.avail_out = static_cast<uInt>(current_size);
+        ret = Z_OK;  // Continue trying
+      }
+    } else if (ret < 0) {
+      // Actual error occurred
+      LOG(WARNING) << "[Fingerprint-DEBUG] zlib inflate failed, error: "
+                   << ret << " msg: " << (strm.msg ? strm.msg : "unknown");
+      inflateEnd(&strm);
+      return base64_data;
+    }
+  }
+
+  // Resize to actual decompressed size
+  raw_pixels.resize(raw_pixels.size() - strm.avail_out);
+  inflateEnd(&strm);
+
+  LOG(INFO) << "[Fingerprint-DEBUG] Decompressed " << raw_pixels.size()
+            << " bytes of pixel data";
+  
+  // ============================================================
+  // CRITICAL FIX (2026-07-16): PNG Filter handling for detectImageRedrawInconsistency
+  // ============================================================
+  // PROBLEM: PNG scanlines use filtering (Sub/Up/Average/Paeth). We were modifying
+  // the FILTERED data directly, but browser decodes PNG by reverse-filtering first.
+  // This caused mismatch between:
+  //   - PNG decoded pixels (after reverse filter) 
+  //   - Our canvas buffer sync (direct LSB flip, no filter involvement)
+  //
+  // SOLUTION: 
+  //   1. Unfilter → get true pixel values
+  //   2. Modify the TRUE pixel values
+  //   3. Re-filter with None(0) for clean output
+  //   Now canvas buffer sync will match PNG decode result exactly!
+  // ============================================================
+
+  // Step 4a: UNFILTER to get real pixel values
+  std::vector<uint8_t> true_pixels = PNGUnfilter(raw_pixels, width, height, 4); // RGBA = 4 bpp
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] Unfiltered to " << true_pixels.size() 
+            << " bytes of true pixel data";
+  
+  // Step 4b: Noise injection on TRUE pixel data (not filtered data!)
+  //
+  // RGB LSB flipping strategy:
+  // - Randomly select R(0), G(1), or B(2) channel for each pixel
+  // - Flip only the Least Significant Bit (LSB): value ^= 0x01
+  // - This changes pixel value by ±1, invisible to human eye
+  // - CANNOT be detected by simple "alpha !== 255" scan!
+
+  uint32_t canvas_hash = GetCanvasHash(width, height);
+  DeterministicPRNG pos_rng(canvas_hash);       // For picking positions
+  DeterministicPRNG chn_rng(canvas_hash ^ 0xABCDEF01u);  // For selecting RGB channel (R/G/B)
+  DeterministicPRNG val_rng(canvas_hash ^ 0xFEDCBA09u);  // Reserved for future use
+
+  size_t total_modified = 0;
+
+  // Calculate target modifications based on intensity setting:
+  // intensity=1: 5 pixels, intensity=2: 7, intensity=5: 12, intensity=10: 20 max
+  size_t target_mods = std::min(
+      static_cast<size_t>(5 + canvas_config_.noise_intensity * 2),
+      (static_cast<size_t>(width) * height) / 50  // Max 2% cap (very safe limit)
+  );
+
+  LOG(INFO) << "[Fingerprint-DEBUG] RGB-LSB mode (with proper unfilter): will modify ~" 
+            << target_mods << " pixels' RGB channels";
+
+  for (size_t i = 0; i < target_mods; ++i) {
+    uint32_t row = pos_rng.Next(height);
+    uint32_t col = pos_rng.Next(width);
+
+    // Select which RGB channel to modify: 0=Red, 1=Green, 2=Blue
+    // NEVER touch channel 3 (Alpha) - that's how we get detected!
+    uint32_t rgb_channel = chn_rng.Next(2);  // Returns 0, 1, or 2
+
+    // Calculate offset in TRUE pixel data (no filter byte!)
+    // Format: [R,G,B,A, R,G,B,A, ...] per row, no filter prefix
+    size_t pixel_offset = (static_cast<size_t>(row) * width + col) * 4 + rgb_channel;
+
+    if (pixel_offset >= true_pixels.size()) continue;
+
+    uint8_t current_val = true_pixels.at(pixel_offset);
+
+    // Flip the Least Significant Bit (LSB) of selected RGB channel
+    uint8_t new_val = current_val ^ 0x01;
+
+    if (new_val != current_val) {
+      true_pixels.at(pixel_offset) = new_val;
+      ++total_modified;
+    }
+  }
+
+  LOG(INFO) << "[Fingerprint-DEBUG] RGB-LSB complete (on true pixels):"
+            << "\n  Modified: " << total_modified << " pixels (R/G/B LSB only, Alpha untouched)";
+
+  if (total_modified == 0) {
+    LOG(WARNING) << "[Fingerprint-DEBUG] No modifications made!";
+    return base64_data;
+  }
+
+  // Step 4c: RE-FILTER with None(0) for clean output
+  std::vector<uint8_t> refiltered_data = PNGFilterNone(true_pixels, width, height, 4, raw_pixels);
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] Refiltered to " << refiltered_data.size() 
+            << " bytes (using None filter)";
+  
+  // Replace raw_pixels with properly filtered data for recompression
+  raw_pixels = std::move(refiltered_data);
+  
+  // Step 5: Recompress modified pixel data using zlib deflate
+  std::vector<uint8_t> compressed_data;
+  
+  // Setup zlib for compression (use same compression level as typical PNG)
+  z_stream comp_strm;
+  memset(&comp_strm, 0, sizeof(comp_strm));
+  
+  if (deflateInit(&comp_strm, Z_DEFAULT_COMPRESSION) != Z_OK) {
+    LOG(ERROR) << "[Fingerprint-DEBUG] zlib deflateInit failed";
+    return base64_data;
+  }
+  
+  comp_strm.next_in = raw_pixels.data();
+  comp_strm.avail_in = static_cast<uInt>(raw_pixels.size());
+  
+  // Compress with growing output buffer
+  size_t comp_capacity = idat_combined_data.size() + 1024;  // Start with original size + room
+  compressed_data.resize(comp_capacity);
+  comp_strm.next_out = compressed_data.data();
+  comp_strm.avail_out = static_cast<uInt>(comp_capacity);
+  
+  ret = deflate(&comp_strm, Z_FINISH);
+  while (ret == Z_OK) {
+    // Need more output space
+    size_t current_size = compressed_data.size();
+    compressed_data.resize(current_size * 2);
+    comp_strm.next_out = &compressed_data.at(current_size);  // Safe: bounds-checked
+    comp_strm.avail_out = static_cast<uInt>(current_size);
+    ret = deflate(&comp_strm, Z_FINISH);
+  }
+  
+  if (ret != Z_STREAM_END) {
+    LOG(ERROR) << "[Fingerprint-DEBUG] zlib deflate failed, error: " << ret;
+    deflateEnd(&comp_strm);
+    return base64_data;
+  }
+  
+  // Resize to actual compressed size
+  size_t final_comp_size = compressed_data.size() - comp_strm.avail_out;
+  compressed_data.resize(final_comp_size);
+  deflateEnd(&comp_strm);
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] Recompressed to " << final_comp_size
+            << " bytes (original was " << idat_combined_data.size() << ")";
+
+  // Step 6: Rebuild PNG with new IDAT chunk
+  std::vector<uint8_t> new_png;
+  new_png.reserve(png_data.size() + static_cast<int>(final_comp_size) -
+                  static_cast<int>(idat_total_size) + 100);  // Estimate new size
+
+  // Copy everything before first IDAT (signature + IHDR + other chunks)
+  new_png.insert(new_png.end(), png_data.begin(), png_data.begin() + idat_start_offset);
+  
+  // Write new IDAT chunk:
+  // 1. Length (big-endian)
+  uint32_t new_idat_len = static_cast<uint32_t>(final_comp_size);
+  new_png.push_back(static_cast<uint8_t>((new_idat_len >> 24) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>((new_idat_len >> 16) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>((new_idat_len >> 8) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>(new_idat_len & 0xFF));
+  
+  // 2. Chunk type "IDAT"
+  new_png.push_back('I');
+  new_png.push_back('D');
+  new_png.push_back('A');
+  new_png.push_back('T');
+  
+  // 3. Compressed data
+  new_png.insert(new_png.end(), compressed_data.begin(), compressed_data.end());
+  
+  // 4. CRC32 (calculated over type + data)
+  uLong crc_val = crc32(0L, Z_NULL, 0);
+  crc_val = crc32(crc_val, reinterpret_cast<const Bytef*>("IDAT"), 4);
+  crc_val = crc32(crc_val, compressed_data.data(), static_cast<uInt>(compressed_data.size()));
+  
+  new_png.push_back(static_cast<uint8_t>((crc_val >> 24) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>((crc_val >> 16) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>((crc_val >> 8) & 0xFF));
+  new_png.push_back(static_cast<uint8_t>(crc_val & 0xFF));
+  
+  // Copy everything after all IDAT chunks (other chunks after IDATs + IEND)
+  size_t old_idat_end = idat_start_offset + idat_total_size;
+  if (old_idat_end < png_data.size()) {
+    new_png.insert(new_png.end(), png_data.begin() + old_idat_end, png_data.end());
+  }
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] New PNG size: " << new_png.size() 
+            << " bytes (original: " << png_data.size() << ")";
+  
+  // Step 7: Re-encode to Base64
+  std::string modified_base64 = Base64Encode(new_png);
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] ✅ Completed pixel-level injection:";
+  LOG(INFO) << "[Fingerprint-DEBUG] Original base64: " << base64_str.length() << " chars";
+  LOG(INFO) << "[Fingerprint-DEBUG] Modified base64: " << modified_base64.length() << " chars";
+  LOG(INFO) << "[Fingerprint-DEBUG] Pixels modified: " << total_modified;
+  
+  return String(modified_base64.c_str());
+}
