+void FingerprintManager::ApplyUserAgentOverrides(
+    UserAgentMetadata& metadata) const {
+  UserAgentConfig ua_config = GetUserAgentConfig();
+  if (!ua_config.enabled || !ua_config.is_valid) {
+    return;
+  }
+
+  if (ua_config.brands.has_value()) {
+    metadata.brand_version_list.clear();
+    for (const auto& entry : *ua_config.brands) {
+      metadata.brand_version_list.emplace_back(entry.brand.Utf8().c_str(),
+                                               entry.version.Utf8().c_str());
+    }
+  }
+  if (ua_config.full_version_list.has_value()) {
+    metadata.brand_full_version_list.clear();
+    for (const auto& entry : *ua_config.full_version_list) {
+      metadata.brand_full_version_list.emplace_back(
+          entry.brand.Utf8().c_str(), entry.version.Utf8().c_str());
+    }
+  }
+  if (ua_config.mobile.has_value()) {
+    metadata.mobile = *ua_config.mobile;
+  }
+  if (ua_config.platform.has_value()) {
+    metadata.platform = ua_config.platform->Utf8().c_str();
+  }
+  if (ua_config.platform_version.has_value()) {
+    metadata.platform_version = ua_config.platform_version->Utf8().c_str();
+  }
+  if (ua_config.architecture.has_value()) {
+    metadata.architecture = ua_config.architecture->Utf8().c_str();
+  }
+  if (ua_config.model.has_value()) {
+    metadata.model = ua_config.model->Utf8().c_str();
+  }
+  if (ua_config.ua_full_version.has_value()) {
+    metadata.full_version = ua_config.ua_full_version->Utf8().c_str();
+  }
+  if (ua_config.bitness.has_value()) {
+    metadata.bitness = ua_config.bitness->Utf8().c_str();
+  }
+  if (ua_config.wow64.has_value()) {
+    metadata.wow64 = *ua_config.wow64;
+  }
+  if (ua_config.form_factors.has_value()) {
+    metadata.form_factors.clear();
+    for (const auto& form_factor : *ua_config.form_factors) {
+      metadata.form_factors.push_back(form_factor.Utf8().c_str());
+    }
+  }
+
+  LOG(INFO) << "[Fingerprint] UserAgentMetadata overrides applied (headers + JS)";
+}
