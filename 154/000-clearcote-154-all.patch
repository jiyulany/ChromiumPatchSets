+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_FINGERPRINT_MANAGER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_FINGERPRINT_MANAGER_H_
