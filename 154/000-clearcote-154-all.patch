+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/jwt_license/jwt_license_monitor.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/process/process.h"
+#include "base/strings/stringprintf.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace {
+
+// 授权服务器地址：命令行开关 > 环境变量 > 编译默认（本地联调）。
+constexpr char kDefaultServerUrl[] = "http://127.0.0.1:8000";
+constexpr char kSwitchServerUrl[] = "license-server-url";
+constexpr char kEnvServerUrl[] = "LICENSE_SERVER_URL";
+constexpr char kHeartbeatPath[] = "/api/v1/heartbeat";
+
+// 设备标识：由浏览器管理器注入，命令行开关 > 环境变量；无默认值，缺失时
+// 拒绝运行。刻意不落盘到 user data dir（清缓存/换 Profile 不影响标识）。
+constexpr char kSwitchDeviceId[] = "license-device-id";
+constexpr char kEnvDeviceId[] = "LICENSE_DEVICE_ID";
+
+// 网络失败容错：连续 3 次失败进入 10 分钟离线宽限期，超期仍未恢复则终止。
+constexpr int kMaxConsecutiveFailures = 3;
+constexpr base::TimeDelta kOfflineGracePeriod = base::Minutes(10);
+
+// code 码表（LICENSE_SERVER_DESIGN.md §3）。
+constexpr int kCodeOk = 0;
+constexpr int kCodeExpired = 1001;
+constexpr int kCodeRevoked = 1002;
+constexpr int kCodeDeviceMismatch = 1003;
+constexpr int kCodeTokenInvalid = 1004;
+constexpr int kCodeRetryLater = 1005;
+
+std::string TrimTrailingSlash(std::string url) {
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+  return url;
+}
+
+// 取值优先级：命令行开关 > 环境变量；两者都未提供时返回空。
+// 注意：base::Environment::GetVar 只接受 cstring_view（字面量数组或
+// std::string），不能把退化为指针的 const char* 直接传入，故用 std::string。
+std::optional<std::string> GetSwitchOrEnv(const std::string& switch_name,
+                                          const std::string& env_name) {
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switch_name)) {
+    std::string value = command_line->GetSwitchValueASCII(switch_name);
+    if (!value.empty()) {
+      return value;
+    }
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (env) {
+    std::optional<std::string> value = env->GetVar(env_name);
+    if (value && !value->empty()) {
+      return value;
+    }
+  }
+  return std::nullopt;
+}
+
+constexpr net::NetworkTrafficAnnotationTag kLicenseTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("jwt_license_heartbeat", R"(
+        semantics {
+          sender: "Fingerprint License Monitor"
+          description:
+            "Periodically reports a license JWT and a device identifier to the "
+            "authorization server so that the server can grant, revoke or renew "
+            "the running browser's license at runtime."
+          trigger:
+            "Periodic heartbeat timer, every interval set by the license token "
+            "(default 60 seconds)."
+          data: "An RS256 JWT license token and a device identifier."
+          destination: OTHER
+          user_data {
+            type: NONE
+          }
+          last_reviewed: "2026-09-06"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "This feature is compiled into the customized fingerprint browser "
+            "and cannot be disabled at runtime."
+        })");
+
+}  // namespace
+
+namespace jwt_license {
+
+JwtLicenseMonitor::JwtLicenseMonitor() = default;
+JwtLicenseMonitor::~JwtLicenseMonitor() = default;
+
+// static
+JwtLicenseMonitor* JwtLicenseMonitor::GetInstance() {
+  // 进程级单例，浏览器进程生命周期内不销毁。
+  static JwtLicenseMonitor* instance = new JwtLicenseMonitor();
+  return instance;
+}
+
+void JwtLicenseMonitor::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+
+  // 延迟到主消息循环运行、网络上下文就绪之后再初始化。
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&JwtLicenseMonitor::TryInit,
+                     weak_ptr_factory_.GetWeakPtr(), 0),
+      base::Seconds(3));
+}
+
+void JwtLicenseMonitor::TryInit(int attempt) {
+  if (!g_browser_process || !g_browser_process->shared_url_loader_factory()) {
+    if (attempt < 10) {  // 最多再等 ~20 秒
+      content::GetUIThreadTaskRunner({})->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&JwtLicenseMonitor::TryInit,
+                         weak_ptr_factory_.GetWeakPtr(), attempt + 1),
+          base::Seconds(2));
+      return;
+    }
+  }
+  InitOnUiThread();
+}
+
+void JwtLicenseMonitor::InitOnUiThread() {
+  // token 来源：--validate=<JWT>（content 层启动校验已保证其存在且有效）。
+  token_ = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "validate");
+  if (token_.empty()) {
+    HandleFatal("未检测到 --validate 授权参数，拒绝运行。");
+    return;
+  }
+
+  // device_id 必须由浏览器管理器显式提供（命令行或环境变量），缺失即拒绝。
+  if (!ResolveDeviceId()) {
+    HandleFatal("缺少设备标识参数 --" + std::string(kSwitchDeviceId) +
+                "=<uuid>，拒绝运行。");
+    return;
+  }
+
+  server_base_url_ = GetServerUrl();
+  url_loader_factory_ = g_browser_process->shared_url_loader_factory();
+  if (!url_loader_factory_) {
+    HandleFatal("浏览器网络上下文不可用，拒绝运行。");
+    return;
+  }
+
+  ParseHeartbeatIntervalFromToken();
+
+  LOG(INFO) << "[JwtLicense] runtime monitor started: server="
+            << server_base_url_ << " device=" << device_id_
+            << " interval=" << heartbeat_interval_seconds_ << "s";
+
+  heartbeat_timer_.Start(
+      FROM_HERE, base::Seconds(heartbeat_interval_seconds_),
+      base::BindRepeating(&JwtLicenseMonitor::HeartbeatTick,
+                          weak_ptr_factory_.GetWeakPtr()));
+  HeartbeatTick();
+}
+
+bool JwtLicenseMonitor::ResolveDeviceId() {
+  std::optional<std::string> device =
+      GetSwitchOrEnv(kSwitchDeviceId, kEnvDeviceId);
+  if (!device) {
+    LOG(ERROR) << "[JwtLicense] device id not provided by manager (--"
+               << kSwitchDeviceId << " or env " << kEnvDeviceId << ")";
+    return false;
+  }
+  device_id_ = *device;
+  return true;
+}
+
+void JwtLicenseMonitor::ParseHeartbeatIntervalFromToken() {
+  // token 结构（header.payload.signature）已由启动校验保证；此处只解码
+  // payload 读取 claims.hbt，失败时沿用默认 60s。
+  const size_t dot1 = token_.find('.');
+  const size_t dot2 = token_.find('.', dot1 + 1);
+  if (dot1 == std::string::npos || dot2 == std::string::npos) {
+    return;
+  }
+  std::string payload_json;
+  if (!base::Base64UrlDecode(
+          token_.substr(dot1 + 1, dot2 - dot1 - 1),
+          base::Base64UrlDecodePolicy::DISALLOW_PADDING, &payload_json)) {
+    return;
+  }
+  std::optional<base::Value> payload = base::JSONReader::Read(
+      payload_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!payload || !payload->is_dict()) {
+    return;
+  }
+  const std::optional<int> hbt = payload->GetDict().FindInt("hbt");
+  if (hbt.has_value() && *hbt >= 30 && *hbt <= 300) {
+    heartbeat_interval_seconds_ = *hbt;
+  }
+}
+
+std::string JwtLicenseMonitor::GetServerUrl() const {
+  std::optional<std::string> value =
+      GetSwitchOrEnv(kSwitchServerUrl, kEnvServerUrl);
+  if (value) {
+    return TrimTrailingSlash(*value);
+  }
+  return kDefaultServerUrl;
+}
+
+std::string JwtLicenseMonitor::ComposeRequestBody() const {
+  // 字段全部来自受限字符集（base64url / uuid / 十进制），无需 JSON 转义。
+  return base::StringPrintf(
+      "{\"token\":\"%s\",\"device_id\":\"%s\",\"client_ts\":%lld}",
+      token_.c_str(), device_id_.c_str(),
+      static_cast<long long>(base::Time::Now().ToTimeT()));
+}
+
+void JwtLicenseMonitor::HeartbeatTick() {
+  if (active_loader_) {
+    return;  // 上一跳未完成，跳过本轮
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(server_base_url_ + kHeartbeatPath);
+  request->method = "POST";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  active_loader_ = network::SimpleURLLoader::Create(
+      std::move(request), kLicenseTrafficAnnotation);
+  active_loader_->AttachStringForUpload(ComposeRequestBody(),
+                                        "application/json");
+  active_loader_->SetTimeoutDuration(base::Seconds(10));
+
+  active_loader_->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&JwtLicenseMonitor::OnHeartbeatResponse,
+                     weak_ptr_factory_.GetWeakPtr()),
+      64 * 1024);
+}
+
+void JwtLicenseMonitor::OnHeartbeatResponse(
+    std::optional<std::string> body) {
+  active_loader_.reset();
+
+  if (!body) {
+    HandleNetworkFailure("network error or timeout");
+    return;
+  }
+  std::optional<base::DictValue> resp =
+      base::JSONReader::ReadDict(*body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!resp) {
+    HandleNetworkFailure("non-JSON server response");
+    return;
+  }
+  const int code = resp->FindInt("code").value_or(-1);
+  const std::string* msg = resp->FindString("msg");
+  const std::string* new_token = resp->FindString("new_token");
+  HandleServerVerdict(code, msg ? *msg : std::string(), new_token);
+}
+
+void JwtLicenseMonitor::HandleServerVerdict(int code,
+                                            const std::string& msg,
+                                            const std::string* new_token) {
+  switch (code) {
+    case kCodeOk: {
+      consecutive_failures_ = 0;
+      in_offline_grace_ = false;
+      offline_grace_deadline_ = base::TimeTicks();
+      if (new_token && !new_token->empty()) {
+        token_ = *new_token;  // 预留：服务端自动续期下发新 token
+        LOG(INFO) << "[JwtLicense] token renewed by server.";
+      }
+      return;
+    }
+    case kCodeRetryLater:  // 服务端要求稍后重试，按网络失败处理
+      HandleNetworkFailure("server maintenance (1005)");
+      return;
+    case kCodeExpired:
+      HandleFatal("授权已到期（" + msg + "），请联系授权方续期。");
+      return;
+    case kCodeRevoked:
+      HandleFatal("授权已被吊销（" + msg + "），请联系授权方。");
+      return;
+    case kCodeDeviceMismatch:
+      HandleFatal("授权与本机设备不匹配（" + msg + "）。");
+      return;
+    case kCodeTokenInvalid:
+      HandleFatal("授权令牌无效（" + msg + "）。");
+      return;
+    default:
+      HandleFatal("授权服务返回未知状态 code=" + std::to_string(code));
+      return;
+  }
+}
+
+void JwtLicenseMonitor::HandleNetworkFailure(const std::string& reason) {
+  ++consecutive_failures_;
+  LOG(WARNING) << "[JwtLicense] heartbeat failed (" << consecutive_failures_
+               << "/" << kMaxConsecutiveFailures << "): " << reason;
+
+  if (consecutive_failures_ < kMaxConsecutiveFailures) {
+    return;
+  }
+  if (!in_offline_grace_) {
+    in_offline_grace_ = true;
+    offline_grace_deadline_ = base::TimeTicks::Now() + kOfflineGracePeriod;
+    LOG(WARNING) << "[JwtLicense] entered offline grace period ("
+                 << kOfflineGracePeriod.InMinutes()
+                 << " min); will terminate if still unreachable.";
+    return;
+  }
+  if (base::TimeTicks::Now() >= offline_grace_deadline_) {
+    HandleFatal("无法连接授权服务器且已超过离线宽限期，请联网后重试。");
+  }
+}
+
+void JwtLicenseMonitor::HandleFatal(const std::string& reason) {
+  LOG(ERROR) << "[JwtLicense] FATAL: " << reason;
+  base::Process::TerminateCurrentProcessImmediately(1);
+}
+
+}  // namespace jwt_license
