+bool FingerprintManager::IsEnabled() const {
+  base::AutoLock auto_lock(lock_);
+  
+  // DEBUG: 记录 IsEnabled 被调用
+  LOG(INFO) << "[Fingerprint-DEBUG] IsEnabled() called - initialized_=" 
+            << initialized_ << ", enabled=" << canvas_config_.enabled 
+            << ", intensity=" << canvas_config_.noise_intensity;
+  
+  // Lazy initialization: auto-initialize from command line on first use
+  if (!initialized_) {
+    LOG(INFO) << "[Fingerprint-DEBUG] Triggering LazyInitialize()...";
+    // Use const_cast to modify initialized_ flag in const method (thread-safe due to lock)
+    const_cast<FingerprintManager*>(this)->LazyInitialize();
+  }
+  
+  bool result = initialized_ && canvas_config_.enabled && canvas_config_.noise_intensity > 0;
+  LOG(INFO) << "[Fingerprint-DEBUG] IsEnabled() returning: " << (result ? "TRUE ✅" : "FALSE ❌");
+  return result;
+}
