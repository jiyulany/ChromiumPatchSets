+void FingerprintManager::Initialize(const base::FilePath& config_path) {
+  base::AutoLock auto_lock(lock_);
+  
+  if (LoadConfig(config_path)) {
+    initialized_ = true;
+    // ★ Apply timezone override immediately after config load
+    ApplyTimezoneOverride();
+    // ★ Apply language override via ICU default locale
+    ApplyLanguageOverride();
+    if (canvas_config_.enabled && canvas_config_.noise_intensity > 0) {
+      LOG(INFO) << "[Fingerprint] Initialized with seed: " 
+                << canvas_config_.noise_seed 
+                << ", intensity: " 
+                << canvas_config_.noise_intensity;
+    }
+  } else {
+    LOG(WARNING) << "[Fingerprint] Failed to load config from: "
+                 << config_path.value();
+  }
+}
+
+void FingerprintManager::LazyInitialize() {
+  LOG(INFO) << "[Fingerprint-DEBUG] ===== LazyInitialize() called =====";
+  
+  // Strategy: Browser process reads file and passes JSON content via --fingerprint-json
+  // (Renderer sandbox cannot access filesystem directly)
+  const char kFingerprintJson[] = "fingerprint-json";
+  const char kCanvasConfig[] = "fingerprint-config";
+  
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  
+  // DEBUG: 打印命令行参数数量及所有参数
+  const base::CommandLine::StringVector& args = command_line->argv();
+  LOG(INFO) << "[Fingerprint-DEBUG] Total argc: " << args.size();
+  for (size_t i = 0; i < args.size(); i++) {
+    std::string arg_str;
+#ifdef OS_WIN
+    arg_str = base::WideToUTF8(args[i]);
+#else
+    arg_str = args[i];
+#endif
+    LOG(INFO) << "[Fingerprint-DEBUG] argv[" << i << "]: " << arg_str;
+  }
+  
+  bool config_loaded = false;
+  
+  // Priority 1: Read JSON content from --fingerprint-json (from Browser process)
+  if (command_line->HasSwitch(kFingerprintJson)) {
+    std::string json_content = command_line->GetSwitchValueUTF8(kFingerprintJson);
+    LOG(INFO) << "[Fingerprint-DEBUG] Found --fingerprint-json: "
+              << json_content.length() << " bytes";
+    
+    if (!json_content.empty() && ParseJsonConfig(json_content)) {
+      initialized_ = true;
+      config_loaded = true;
+      ApplyTimezoneOverride();
+      ApplyLanguageOverride();
+      LOG(INFO) << "[Fingerprint] ✅ Loaded config from JSON parameter";
+    }
+  }
+  
+  // Priority 2: Fallback to reading file path (for non-sandboxed mode)
+  if (!config_loaded && command_line->HasSwitch(kCanvasConfig)) {
+    base::FilePath config_path =
+        command_line->GetSwitchValuePath(kCanvasConfig);
+    LOG(INFO) << "[Fingerprint-DEBUG] Fallback: trying file path: " << config_path.value();
+    
+    Initialize(config_path);
+    config_loaded = initialized_;
+  }
+  
+  if (!config_loaded) {
+    // Mark as initialized even without config to avoid repeated checks
+    initialized_ = true;
+    LOG(WARNING) << "[Fingerprint] ⚠️ No config loaded, feature DISABLED!";
+  }
+  
+  LOG(INFO) << "[Fingerprint-DEBUG] ===== LazyInitialize() finished, initialized_=" 
+            << initialized_ << " =====";
+}
