+bool FingerprintManager::LoadConfig(const base::FilePath& config_path) {
+  std::string json_content;
+  if (!base::ReadFileToString(config_path, &json_content)) {
+    LOG(ERROR) << "[Fingerprint] Failed to read config file: " 
+               << config_path.value();
+    return false;
+  }
+  
+  return ParseJsonConfig(json_content);
+}
+
+bool FingerprintManager::ParseJsonConfig(const std::string& json_content) {
+  LOG(INFO) << "[Fingerprint-DEBUG] ParseJsonConfig() called, JSON length: " 
+            << json_content.length();
+  LOG(INFO) << "[Fingerprint-DEBUG] JSON content: " << json_content;
+  
+  std::optional<base::Value> root = base::JSONReader::Read(json_content, base::JSON_PARSE_RFC);
+  if (!root || !root->is_dict()) {
+    LOG(ERROR) << "[Fingerprint] Invalid JSON format in config";
+    return false;
+  }
+  
+  const base::DictValue& root_dict = root->GetDict();
+  
+  // ★ 解析 canvas_fp 配置
+  const base::DictValue* canvas_fp_dict = root_dict.FindDict("canvas_fp");
+  if (!canvas_fp_dict) {
+    // 兼容旧格式
+    LOG(WARNING) << "[Fingerprint] 'canvas_fp' key not found, trying root level (legacy mode)";
+    
+    const std::string* seed_str = root_dict.FindString("canvas_noise_seed");
+    if (seed_str) {
+      uint32_t hash = 0;
+      for (char c : *seed_str) {
+        hash = hash * 31 + static_cast<unsigned char>(c);
+      }
+      canvas_config_.noise_seed = hash;
+    } else {
+      absl::optional<int> seed_int = root_dict.FindInt("canvas_noise_seed");
+      canvas_config_.noise_seed = seed_int.has_value() ? static_cast<uint32_t>(seed_int.value()) : 0x12345678;
+    }
+    
+    absl::optional<int> intensity = root_dict.FindInt("noise_intensity");
+    canvas_config_.noise_intensity = intensity.has_value() ? std::clamp(intensity.value(), 0, 10) : 1;
+    
+    absl::optional<bool> enabled = root_dict.FindBool("enabled");
+    canvas_config_.enabled = enabled.value_or(true);
+    
+  } else {
+    // 新格式
+    LOG(INFO) << "[Fingerprint] Using new nested 'canvas_fp' structure";
+    
+    const std::string* seed_str = canvas_fp_dict->FindString("canvas_noise_seed");
+    if (seed_str) {
+      uint32_t hash = 0;
+      for (char c : *seed_str) {
+        hash = hash * 31 + static_cast<unsigned char>(c);
+      }
+      canvas_config_.noise_seed = hash;
+    } else {
+      absl::optional<int> seed_int = canvas_fp_dict->FindInt("canvas_noise_seed");
+      canvas_config_.noise_seed = seed_int.has_value() ? static_cast<uint32_t>(seed_int.value()) : 0x12345678;
+    }
+    
+    absl::optional<int> intensity = canvas_fp_dict->FindInt("noise_intensity");
+    canvas_config_.noise_intensity = intensity.has_value() ? std::clamp(intensity.value(), 0, 10) : 1;
+    
+    absl::optional<bool> enabled = canvas_fp_dict->FindBool("enabled");
+    canvas_config_.enabled = enabled.value_or(true);
+  }
+  
+  canvas_config_.is_valid = true;
+  LOG(INFO) << "[Fingerprint-DEBUG] Canvas config: seed=" << canvas_config_.noise_seed 
+            << ", intensity=" << canvas_config_.noise_intensity 
+            << ", enabled=" << canvas_config_.enabled;
+  
+  // ============================================================
+  // ★ 解析 webgl_fp 配置（新增）
+  // ============================================================
+  const base::DictValue* webgl_fp_dict = root_dict.FindDict("webgl_fp");
+  if (webgl_fp_dict) {
+    LOG(INFO) << "[Fingerprint] Parsing 'webgl_fp' configuration...";
+    
