+
+void FingerprintManager::ApplyTimezoneOverride() {
+  if (!timezone_config_.enabled || !timezone_config_.is_valid ||
+      timezone_config_.timezone.empty()) {
+    return;
+  }
+
+  auto result = TimeZoneController::SetTimeZoneOverride(
+      timezone_config_.timezone);
+  if (result.status ==
+      TimeZoneController::TimeZoneOverrideStatus::kSuccess) {
+    timezone_override_handle_ = std::move(result.handle);
+    LOG(INFO) << "[Fingerprint] Timezone override applied: "
+              << timezone_config_.timezone;
+  } else {
+    LOG(WARNING) << "[Fingerprint] Failed to apply timezone override: "
+                 << timezone_config_.timezone
+                 << " (status=" << static_cast<int>(result.status) << ")";
+  }
+}
+
+void FingerprintManager::ApplyLanguageOverride() {
+  if (!language_config_.enabled || !language_config_.is_valid ||
+      language_config_.languages.empty()) {
+    return;
+  }
+
+  // Use the first language in the list as the ICU default locale
+  std::string locale = language_config_.languages[0].Ascii();
+  LOG(INFO) << "[Fingerprint] Applying ICU locale override: " << locale;
+  base::i18n::SetICUDefaultLocale(locale);
+  LOG(INFO) << "[Fingerprint] ICU default locale set to: " << locale;
+
+  // Notify all V8 main-thread isolates to clear their cached default locale.
+  // Without this, V8's Isolate::DefaultLocale() keeps the stale value read
+  // at isolate creation time and never re-reads from icu::Locale::getDefault().
+  Thread::MainThread()
+      ->Scheduler()
+      ->ToMainThreadScheduler()
+      ->ForEachMainThreadIsolate([](v8::Isolate* isolate) {
+        DCHECK(isolate);
+        isolate->LocaleConfigurationChangeNotification();
+        isolate->DateTimeConfigurationChangeNotification();
+        LOG(INFO) << "[Fingerprint] Notified V8 isolate of locale change";
+      });
+
+  // Also notify all worker thread isolates
+  WorkerThread::CallOnAllWorkerThreads(
+      [](WorkerThread* worker_thread) {
+        DCHECK(worker_thread->IsCurrentThread());
+        v8::Isolate* isolate = worker_thread->GetIsolate();
+        if (isolate) {
+          isolate->LocaleConfigurationChangeNotification();
+          isolate->DateTimeConfigurationChangeNotification();
+        }
+      },
+      TaskType::kInternalDefault);
+
+  LOG(INFO) << "[Fingerprint] All V8 isolates notified of locale change: "
+            << locale;
+}
