+namespace blink {
+
+// Forward declaration
+struct UserAgentMetadata;
+
+// ============================================================
+// Canvas fingerprint configuration (canvas_fp in JSON)
+// ============================================================
+struct CanvasConfig {
+  // Seed value for noise generation (ensures consistent fingerprint per session)
+  uint32_t noise_seed = 0;
+
+  // Noise intensity level (0-10, where 0 = disabled, 1 = minimal, 10 = maximum)
+  int noise_intensity = 1;
+
+  // Enable or disable canvas fingerprint randomization
+  bool enabled = false;
+
+  // Whether configuration has been loaded successfully
+  bool is_valid = false;
+};
+
+// ============================================================
+// WebGL fingerprint configuration (webgl_fp in JSON)
+// ============================================================
+struct WebGLConfig {
+  // Enable or disable WebGL fingerprint randomization
+  bool enabled = false;
+
+  // Seed for deterministic random string generation
+  uint32_t seed = 0;
+
+  // Custom values (empty = use generated random)
+  String vendor;      // gl.VENDOR override
+  String renderer;    // gl.RENDERER override
+  String version;     // gl.VERSION override
+
+  // Extension manipulation
+  Vector<String> remove_extensions;  // Extensions to hide
+  Vector<String> add_extensions;     // Fake extensions to add
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+// ============================================================
+// Font fingerprint configuration (font_fp in JSON)
+// ============================================================
+struct FontConfig {
+  // Enable or disable font fingerprint randomization
+  bool enabled = false;
+
+  // Seed for deterministic font filtering
+  uint32_t seed = 0;
+
+  // Fonts to always hide (exact match)
+  Vector<String> remove_fonts;
+
+  // Probability of hiding a font (0.0-1.0, 0=never, 1=always)
+  // Used with seed for deterministic random hiding
+  float remove_probability = 0.0f;
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+// ============================================================
+// GPU fingerprint configuration (gpu_fp in JSON)
+// Overrides UNMASKED_VENDOR_WEBGL and UNMASKED_RENDERER_WEBGL
+// ============================================================
+struct GPUConfig {
+  // Enable or disable GPU fingerprint randomization
+  bool enabled = false;
+
+  // Override for UNMASKED_VENDOR_WEBGL (e.g. "Google Inc. (NVIDIA)")
+  // Empty = use real GPU vendor
+  String unmasked_vendor;
+
+  // Override for UNMASKED_RENDERER_WEBGL
+  // (e.g. "ANGLE (NVIDIA, NVIDIA GeForce RTX 3080 (0x00002216)
+  //         Direct3D11 vs_5_0 ps_5_0, D3D11)")
+  // Empty = use real GPU renderer
+  String unmasked_renderer;
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+// ============================================================
+// Audio fingerprint configuration (audio_fp in JSON)
+// Injects deterministic noise into OfflineAudioContext rendered buffer
+// ============================================================
+struct AudioConfig {
+  // Enable or disable audio fingerprint randomization
+  bool enabled = false;
+
+  // Seed for deterministic noise generation
+  uint32_t seed = 0;
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+// ============================================================
+// UserAgentData fingerprint configuration (useragent_fp in JSON)
+// Overrides navigator.userAgentData (brands/mobile/platform) and
+// getHighEntropyValues() results. Only fields present in the JSON
+// are overridden; absent fields keep their real values.
+// ============================================================
+struct UserAgentBrandVersionEntry {
+  String brand;
+  String version;
+};
+
+// ============================================================
+// WebRTC IP leak protection configuration (webrtc_fp in JSON)
+// Prevents WebRTC from leaking the real local/public IP to JS:
+//   mode "mask":  replace IPs in ICE candidates / SDP with the
+//                 configured "ip" (should be the proxy/VPN exit IP)
+//   mode "block": drop host/srflx/prflx candidates entirely,
+//                 keep only relay (TURN) candidates
+// ============================================================
+enum class WebRTCMode { kOff, kMask, kBlock };
+
+struct WebRTCConfig {
+  // Enable or disable WebRTC IP leak protection
+  bool enabled = false;
+
+  // kMask / kBlock / kOff
+  WebRTCMode mode = WebRTCMode::kOff;
+
+  // Replacement IP used in kMask mode (e.g. proxy/VPN exit IP)
+  String ip;
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+struct UserAgentConfig {
+  // Enable or disable userAgentData overrides
+  bool enabled = false;
+
+  // Optional overrides: nullopt = keep the real value.
+  // brands:             navigator.userAgentData.brands & getHighEntropyValues "brands"
+  // full_version_list:  getHighEntropyValues "fullVersionList"
+  // mobile:             navigator.userAgentData.mobile & "mobile"
+  // platform:           navigator.userAgentData.platform & "platform"
+  // platform_version:   "platformVersion"
+  // architecture:       "architecture"
+  // model:              "model"
+  // ua_full_version:    "uaFullVersion"
+  // bitness:            "bitness"
+  // wow64:              "wow64"
+  // form_factors:       "formFactors"
+  absl::optional<Vector<UserAgentBrandVersionEntry>> brands;
+  absl::optional<Vector<UserAgentBrandVersionEntry>> full_version_list;
+  absl::optional<bool> mobile;
+  absl::optional<String> platform;
+  absl::optional<String> platform_version;
+  absl::optional<String> architecture;
+  absl::optional<String> model;
+  absl::optional<String> ua_full_version;
+  absl::optional<String> bitness;
+  absl::optional<bool> wow64;
+  absl::optional<Vector<String>> form_factors;
+
+  // Whether configuration has been loaded
+  bool is_valid = false;
+};
+
+// ============================================================
+// Language fingerprint configuration (language_fp in JSON)
+// Overrides navigator.language, navigator.languages, and
+// Accept-Language HTTP request header.
+// ============================================================
+struct LanguageConfig {
+  bool enabled = false;
+
+  // Override navigator.languages (first entry = navigator.language)
+  Vector<String> languages;
+
+  // Override Accept-Language HTTP header (e.g. "zh-CN,zh;q=0.9,en;q=0.8")
+  String accept_language;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Timezone fingerprint configuration (timezone_fp in JSON)
+// Overrides Intl.DateTimeFormat().resolvedOptions().timeZone
+// ============================================================
+struct TimezoneConfig {
+  bool enabled = false;
+
+  // IANA timezone ID (e.g. "Asia/Shanghai", "America/New_York")
+  String timezone;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Hardware fingerprint configuration (hw_fp in JSON)
+// Overrides navigator.hardwareConcurrency (CPU core count)
+// ============================================================
+struct HardwareConfig {
+  bool enabled = false;
+
+  // Override CPU core count (e.g. 4, 8, 16)
+  unsigned int hardware_concurrency = 0;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Device memory fingerprint configuration (device_memory_fp in JSON)
+// Overrides navigator.deviceMemory (RAM size in GB)
+// ============================================================
+struct DeviceMemoryConfig {
+  bool enabled = false;
+
+  // Override device memory in GB (e.g. 4, 8, 16; actual value 0.25 - 8)
+  float device_memory = 0;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// UserAgent (legacy UA string) fingerprint configuration
+// (user_agent_fp in JSON)
+// Overrides navigator.userAgent and HTTP User-Agent header.
+// Separate from useragent_fp which handles userAgentData
+// (Client Hints).
+// ============================================================
+struct UserAgentFpConfig {
+  bool enabled = false;
+
+  // Override navigator.userAgent and HTTP User-Agent header
+  String user_agent;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// ClientRects fingerprint configuration (client_rects_fp in JSON)
+// Injects sub-pixel noise into DOMRect::FromRectF() to create
+// unique ClientRects fingerprint per seed.
+// ============================================================
+struct ClientRectsConfig {
+  bool enabled = false;
+
+  // Seed for deterministic sub-pixel noise.
+  // noise = (seed % 103 / 100000.0) for width
+  //         (seed %  97 / 100000.0) for height
+  // Only applied when rect.x() > 0.
+  int seed = 0;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Screen fingerprint configuration (screen_fp in JSON)
+// Overrides screen.width/height/availWidth/availHeight/colorDepth
+// and matchMedia device-width/device-height to stay consistent.
+// ============================================================
+struct ScreenConfig {
+  bool enabled = false;
+
+  // screen.width (CSS pixels)
+  int width = 0;
+
+  // screen.height (CSS pixels)
+  int height = 0;
+
+  // screen.availWidth (CSS pixels). 0 = use width.
+  int avail_width = 0;
+
+  // screen.availHeight (CSS pixels). 0 = use height.
+  int avail_height = 0;
+
+  // screen.colorDepth. 0 = keep original.
+  int color_depth = 0;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// WebGPU fingerprint configuration (webgpu_fp in JSON)
+// Overrides adapter.features, device.limits, and adapter.info
+// to create unique WebGPU fingerprint per seed.
+// ============================================================
+struct WebGPUConfig {
+  bool enabled = false;
+
+  // Seed for deterministic feature/limit randomization.
+  // Different seeds produce different WebGPU fingerprints.
+  int seed = 0;
+
+  // Override adapter.info.vendor (e.g. "nvidia", "intel", "amd")
+  // Should be consistent with gpu_fp.unmasked_renderer brand.
+  String vendor;
+
+  // Override adapter.info.architecture (e.g. "ampere", "gen-12lp")
+  String architecture;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Voices fingerprint configuration (voices_fp in JSON)
+// Overrides speechSynthesis.getVoices() to control the
+// TTS voice list exposed to web pages.
+// ============================================================
+
+// Single voice entry
+struct VoiceEntry {
+  String name;         // Voice name (e.g. "Microsoft David - English (United States)")
+  String lang;         // BCP-47 language tag (e.g. "en-US")
+  String voice_uri;    // Unique voice URI
+  bool local_service = true;   // localService attribute
+  bool is_default = false;     // default attribute
+};
+
+struct VoicesConfig {
+  bool enabled = false;
+
+  // Custom voice list to expose via speechSynthesis.getVoices().
+  // If empty and enabled=true, hides all voices (returns empty list).
+  Vector<VoiceEntry> voices;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Geolocation fingerprint configuration (geolocation_fp in JSON)
+// Overrides navigator.geolocation.getCurrentPosition/watchPosition.
+// Supports custom position or always-deny mode.
+// ============================================================
+struct GeolocationConfig {
+  bool enabled = false;
+
+  // "custom" = return configured position
+  // "disabled" = always return permission denied error
+  String mode;
+
+  // Custom position (only used when mode == "custom")
+  double latitude = 0;
+  double longitude = 0;
+  double accuracy = 0;  // meters
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Do Not Track fingerprint configuration (do_not_track_fp in JSON)
+// Overrides navigator.doNotTrack and HTTP DNT header.
+// ============================================================
+struct DoNotTrackConfig {
+  bool enabled = false;
+
+  // true  = DNT enabled  (navigator.doNotTrack = "1", HTTP header DNT: 1)
+  // false = DNT disabled (navigator.doNotTrack = null, no DNT header)
+  bool value = false;
+
+  bool is_valid = false;
+};
+
+// ============================================================
+// Singleton manager for ALL fingerprint randomization
+// (Canvas, WebGL, Font, GPU, Audio, Language, Timezone, and future types)
+// ============================================================
+// IMPORTANT: No global state for injection tracking or caching!
+// All noise injection is IDEMPOTENT (deterministic assignment, not flip).
+// This ensures correctness with multi-browser/multi-tab scenarios.
+class FingerprintManager {
+ public:
+  static FingerprintManager* GetInstance();
+
+  // Initialize with configuration file path
+  void Initialize(const base::FilePath& config_path);
+
+  // Lazy initialization from command line (called automatically on first use)
+  void LazyInitialize();
+
+  // Check if canvas fingerprint randomization is enabled
+  bool IsEnabled() const;
+
+  // Get canvas configuration (thread-safe)
+  CanvasConfig GetConfig() const;
+
+  // Get WebGL configuration (thread-safe)
+  WebGLConfig GetWebGLConfig() const;
+
+  // Get Font configuration (thread-safe)
+  FontConfig GetFontConfig() const;
+
+  // Get GPU configuration (thread-safe)
+  GPUConfig GetGPUConfig() const;
+
+  // Get Audio configuration (thread-safe)
+  AudioConfig GetAudioConfig() const;
+
+  // Get UserAgentData configuration (thread-safe)
+  UserAgentConfig GetUserAgentConfig() const;
+
+  // Get WebRTC configuration (thread-safe)
+  WebRTCConfig GetWebRTCConfig() const;
+
+  // Get Language configuration (thread-safe)
+  LanguageConfig GetLanguageConfig() const;
+
+  // Get Timezone configuration (thread-safe)
+  TimezoneConfig GetTimezoneConfig() const;
+
+  // Get Hardware (CPU core count) configuration (thread-safe)
+  HardwareConfig GetHardwareConfig() const;
+
+  // Get DeviceMemory configuration (thread-safe)
+  DeviceMemoryConfig GetDeviceMemoryConfig() const;
+
+  // Get UserAgentFp (legacy navigator.userAgent) configuration (thread-safe)
+  UserAgentFpConfig GetUserAgentFpConfig() const;
+
+  // Get ClientRects configuration (thread-safe)
+  ClientRectsConfig GetClientRectsConfig() const;
+
+  // Get Screen configuration (thread-safe)
+  ScreenConfig GetScreenConfig() const;
+
+  // Get WebGPU configuration (thread-safe)
+  WebGPUConfig GetWebGPUConfig() const;
+
+  // Get Voices configuration (thread-safe)
+  VoicesConfig GetVoicesConfig() const;
+
+  // Get Geolocation configuration (thread-safe)
+  GeolocationConfig GetGeolocationConfig() const;
+
+  // Get DoNotTrack configuration (thread-safe)
+  DoNotTrackConfig GetDoNotTrackConfig() const;
+
+  // Apply timezone override (call once during initialization)
+  void ApplyTimezoneOverride();
+
+  // Apply language override via ICU default locale (call once during initialization)
+  void ApplyLanguageOverride();
+
+  // ★ WebRTC IP 防泄露（按 webrtc_fp 配置）：
+  // 处理 ICE candidate 字符串并返回处理结果；返回空字符串表示该候选
+  // 应被丢弃（block 模式下的非 relay 候选）。
+  String SanitizeWebRTCIceCandidate(const String& candidate) const;
+  // 处理 SDP 文本：a=candidate 行、c= / o= / a=rtcp 行中的地址。
+  String SanitizeWebRTCSdp(const String& sdp) const;
+  // 处理 icecandidateerror 事件暴露的地址；block 模式返回空字符串。
+  String SanitizeWebRTCErrorAddress(const String& address) const;
+  // 处理 getStats() 的 local-candidate stats 暴露的地址字段
+  //（address / relatedAddress / ip）；block 模式返回空字符串（隐藏），
+  // mask 模式返回配置的 ip。
+  String SanitizeWebRTCStatsAddress(const String& address) const;
+
+  // Check if a font should be hidden (deterministic based on seed)
+  bool ShouldHideFont(const String& font_name) const;
+
+  // Apply deterministic noise to a data URL string based on canvas dimensions
+  String ApplyNoiseToDataURL(const String& data_url,
+                             unsigned width,
+                             unsigned height) const;
+
+  // Generate consistent hash for specific canvas context
+  uint32_t GetCanvasHash(unsigned width, unsigned height) const;
+
+  // ★ Apply useragent_fp config overrides to UserAgentMetadata.
+  // Shared by navigator.userAgentData JS API and Sec-CH-UA HTTP headers.
+  void ApplyUserAgentOverrides(UserAgentMetadata& metadata) const;
+
+ private:
+  friend class base::NoDestructor<FingerprintManager>;
+
+  FingerprintManager();
+  ~FingerprintManager() = default;
+
+  // Load and parse JSON configuration file
+  bool LoadConfig(const base::FilePath& config_path);
+
+  // Parse JSON content into config structure
+  bool ParseJsonConfig(const std::string& json_content);
+
+  // Generate noise byte for position (deterministic based on seed)
+  uint8_t GenerateNoiseByte(size_t position) const;
+
+  // Modify Base64 encoded data to introduce subtle pixel changes
+  String InjectNoiseIntoBase64(const String& base64_data,
+                               size_t data_length,
+                               unsigned width,
+                               unsigned height) const;
+
+  mutable base::Lock lock_;
+  CanvasConfig canvas_config_;
+  WebGLConfig webgl_config_;
+  FontConfig font_config_;
+  GPUConfig gpu_config_;
+  AudioConfig audio_config_;
+  UserAgentConfig useragent_config_;
+  WebRTCConfig webrtc_config_;
+  LanguageConfig language_config_;
+  TimezoneConfig timezone_config_;
+  HardwareConfig hardware_config_;
+  DeviceMemoryConfig device_memory_config_;
+  UserAgentFpConfig user_agent_fp_config_;
+  ClientRectsConfig client_rects_config_;
+  ScreenConfig screen_config_;
+  WebGPUConfig webgpu_config_;
+  VoicesConfig voices_config_;
+  GeolocationConfig geolocation_config_;
+  DoNotTrackConfig do_not_track_config_;
+  std::unique_ptr<TimeZoneController::TimeZoneOverride> timezone_override_handle_;
+  bool initialized_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_FINGERPRINT_MANAGER_H_
