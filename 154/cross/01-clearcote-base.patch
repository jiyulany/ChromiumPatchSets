-//     code=1001/1002/1003/1004       到期 / 吊销 / 设备不匹配 / token 非法 → 终止
-//     code=1005 或网络层失败          累计 3 次进入离线宽限期，超期仍失败 → 终止
-//
-// 协议契约见 <repo>/license_server/LICENSE_SERVER_DESIGN.md（配套 FINGERPRINT
-// _MODIFICATION_COMPLETE_GUIDE.md 第 25 章）。
-
-#ifndef CHROME_BROWSER_JWT_LICENSE_JWT_LICENSE_MONITOR_H_
-#define CHROME_BROWSER_JWT_LICENSE_JWT_LICENSE_MONITOR_H_
-
-#include <memory>
-#include <optional>
-#include <string>
-
-#include "base/memory/weak_ptr.h"
-#include "base/timer/timer.h"
-#include "services/network/public/cpp/shared_url_loader_factory.h"
-
-namespace network {
-class SimpleURLLoader;
-}  // namespace network
-
-namespace jwt_license {
-
-class JwtLicenseMonitor {
- public:
-  JwtLicenseMonitor(const JwtLicenseMonitor&) = delete;
-  JwtLicenseMonitor& operator=(const JwtLicenseMonitor&) = delete;
-
-  // 浏览器进程内唯一实例（故意泄漏，进程级单例）。
-  static JwtLicenseMonitor* GetInstance();
-
-  // 浏览器启动完成后调用（ChromeBrowserMainParts::PostBrowserStart）。
-  // 必须在 UI 线程；内部会延迟到主消息循环运行、网络上下文就绪后再初始化。
-  void Start();
-
- private:
-  JwtLicenseMonitor();
-  ~JwtLicenseMonitor();
-
-  // 等待 g_browser_process 与共享 URL loader factory 就绪（最多 ~23 秒）。
-  void TryInit(int attempt);
-  void InitOnUiThread();  // 解析 token / 配置 / 设备 ID 并启动心跳
-
-  // device_id 由浏览器管理器通过命令行开关（或环境变量）注入，不落盘到
-  // user data dir，清缓存/换 Profile 不影响设备标识。
-  bool ResolveDeviceId();
-  void ParseHeartbeatIntervalFromToken();       // 读取 claims.hbt
-  std::string GetServerUrl() const;             // switch > env > 编译默认
-  std::string ComposeRequestBody() const;
-
-  void HeartbeatTick();                         // RepeatingTimer 回调
-  void OnHeartbeatResponse(std::optional<std::string> body);
-  void HandleServerVerdict(int code,
-                           const std::string& msg,
-                           const std::string* new_token);
-  void HandleNetworkFailure(const std::string& reason);
-  void HandleFatal(const std::string& reason);  // LOG + 终止进程
-
-  bool started_ = false;
-  std::string token_;
-  std::string device_id_;
-  std::string server_base_url_;
-  int heartbeat_interval_seconds_ = 60;
-
-  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
-  std::unique_ptr<network::SimpleURLLoader> active_loader_;
-
-  int consecutive_failures_ = 0;           // 连续网络失败次数
-  bool in_offline_grace_ = false;
-  base::TimeTicks offline_grace_deadline_;  // 宽限期截止（单调时钟，防改时间）
-
-  base::RepeatingTimer heartbeat_timer_;
-  base::WeakPtrFactory<JwtLicenseMonitor> weak_ptr_factory_{this};
-};
-
-}  // namespace jwt_license
-
-#endif  // CHROME_BROWSER_JWT_LICENSE_JWT_LICENSE_MONITOR_H_

