-// 授权服务器地址：命令行开关 > 环境变量 > 编译默认（本地联调）。
-constexpr char kDefaultServerUrl[] = "http://127.0.0.1:8000";
-constexpr char kSwitchServerUrl[] = "license-server-url";
-constexpr char kEnvServerUrl[] = "LICENSE_SERVER_URL";
-constexpr char kHeartbeatPath[] = "/api/v1/heartbeat";
-
-// 设备标识：由浏览器管理器注入，命令行开关 > 环境变量；无默认值，缺失时
