+#ifndef CHROME_BROWSER_R0_LICENSE_AUTH_SECURITY_H_
+#define CHROME_BROWSER_R0_LICENSE_AUTH_SECURITY_H_
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace r0_license {
+
+constexpr std::size_t kLeaseSecretBytes = 32;
+constexpr std::size_t kNonceBytes = 16;
+constexpr std::size_t kSignatureBytes = 64;
+constexpr std::size_t kPublicKeyRawBytes = 32;
+constexpr std::size_t kX509Ed25519PrefixBytes = 12;
+constexpr std::size_t kMaxResponseBytes = 64 * 1024;
+constexpr std::size_t kMaxTokenBytes = 32768;
+constexpr std::size_t kMaxRequestBytes = 16 * 1024;
+
+// Lease token verification context. All fields are matched against the token
+// payload claims before any cryptographic verdict is returned.
+struct VerificationContext {
+  std::string api_key_hash;       // 64-char lowercase hex SHA-256 of api_key.
+  std::string lease_id;           // Currently active lease identifier.
+  std::string install_id;         // Stable per-install identifier.
+  std::string instance_id;        // Per-process UUID.
+  std::string platform;           // e.g. "windows-x64".
+  std::string client_version;     // e.g. "r0-chromium-154-1.0.0".
+  std::int64_t expected_sequence = 0;  // 0 = accept any positive sequence.
+  std::uint64_t now_unix_ms = 0;
+};
+
+struct VerifiedToken {
+  std::int64_t sequence = 0;
+  std::uint64_t issued_at_unix_ms = 0;
+  std::uint64_t expires_at_unix_ms = 0;
+};
+
+struct LeaseProof {
+  std::int64_t sequence = 0;
+  std::string nonce;       // base64url(no padding, 16 random bytes).
+  std::string proof;       // base64url(no padding, 32-byte HMAC-SHA256).
+};
+
+// Cryptographically secure random source. Returns false only on RNG failure,
+// in which case *output is left in an unspecified state.
+bool SecureRandomBytes(std::uint8_t* output, std::size_t size);
+
+bool Sha256(const std::uint8_t* bytes,
+            std::size_t size,
+            std::array<std::uint8_t, 32>* output);
+
+std::string Sha256Hex(const std::string& input);
+
+bool HmacSha256(const std::uint8_t* key,
+                std::size_t key_size,
+                const std::string& input,
+                std::array<std::uint8_t, 32>* output);
+
+std::string Base64UrlEncode(const std::uint8_t* bytes, std::size_t size);
+
+// Base64URL decode. When require_no_padding is true the input must contain no
+// trailing '=' characters (matching the v2 protocol's "no padding" rule).
+bool Base64UrlDecode(const std::string& encoded,
+                     bool require_no_padding,
+                     std::vector<std::uint8_t>* output);
+
+bool DecodeLeaseSecret(const std::string& encoded,
+                       std::array<std::uint8_t, kLeaseSecretBytes>* output);
+
+// Verifies that public_key_x509_base64 decodes to a standard X.509
+// SubjectPublicKeyInfo DER for Ed25519 (12-byte ASN.1 prefix + 32-byte key).
+bool ValidateEd25519PublicKeyConfig(
+    const std::string& public_key_x509_base64,
+    std::string* error);
+
+// Verifies the compact Ed25519 token and all v2 protocol claims. The signature
+// is checked against the raw payload bytes (the protocol forbids
+// re-serializing the JSON before verification).
+bool VerifyLeaseToken(const std::string& token,
+                     const std::string& public_key_x509_base64,
+                     const VerificationContext& context,
+                     VerifiedToken* output,
+                     std::string* error);
+
+// Builds an HMAC-SHA256 proof for an alive or end request, including the
+// 16-byte random nonce. Returns false if operation is not "alive" or "end",
+// or if sequence is not positive.
+bool CreateLeaseProof(const std::string& operation,
+                     const std::string& lease_id,
+                     const std::string& install_id,
+                     const std::string& instance_id,
+                     std::int64_t next_sequence,
+                     const std::string& token,
+                     const std::array<std::uint8_t, kLeaseSecretBytes>& secret,
+                     LeaseProof* output);
+
+std::uint64_t UnixTimeMilliseconds();
+
+}  // namespace r0_license
+
+#endif  // CHROME_BROWSER_R0_LICENSE_AUTH_SECURITY_H_
