+// 客户端只用 token 的 expires_at 计算剩余寿命，不信任 lease_ttl_seconds。
+// alive 重试必须复用同一份请求体（protocol §8 的幂等约束）。
+
+#ifndef CHROME_BROWSER_R0_LICENSE_R0_LICENSE_MONITOR_H_
+#define CHROME_BROWSER_R0_LICENSE_R0_LICENSE_MONITOR_H_
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/r0_license/auth_security.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+namespace r0_license {
+
+class R0LicenseMonitor {
+ public:
+  R0LicenseMonitor(const R0LicenseMonitor&) = delete;
+  R0LicenseMonitor& operator=(const R0LicenseMonitor&) = delete;
+
+  static R0LicenseMonitor* GetInstance();
+
+  // 在 ChromeBrowserMainParts::PostBrowserStart 中调用。
+  // 内部延迟到主消息循环运行、网络上下文就绪后再初始化。
+  void Start();
+
+  // 在浏览器进程退出前调用，尽力发送 end 让服务端立即释放实例额度。
+  void Shutdown();
+
+  // 当前是否已通过 start + token 验签（UI 模块可以用来禁用授权功能）。
+  bool IsAuthorized() const { return valid_; }
+
+ private:
+  R0LicenseMonitor();
+  ~R0LicenseMonitor();
+
+  void TryInit(int attempt);
+  void InitOnUiThread();
+
+  bool ResolveApiBase();
+  bool ResolveApiKey();
+  void GenerateInstanceId();
+
+  void StartLease();
+  void OnStartResponse(std::optional<std::string> body);
+
+  bool ScheduleRegularHeartbeat();
+  void HeartbeatTick();
+  bool BeginHeartbeat();
+  void OnHeartbeatResponse(std::optional<std::string> body);
+  bool ScheduleHeartbeatRetry();
+
+  void BeginClose();
+  void SendEndLease();
+  void OnEndResponse(std::optional<std::string> body);
+
+  void HandleFatal(const std::string& reason);
+
+  bool started_ = false;
+  bool closing_ = false;
+  bool valid_ = false;
+
+  // Configuration.
+  std::string api_base_;
+  std::string api_key_;            // secure-cleared after use.
+  std::string api_key_hash_;
+
+  // Stable identity.
+  std::string install_id_;
+  std::string instance_id_;
+
+  // Lease state.
+  std::string lease_id_;
+  std::string token_;
+  std::array<std::uint8_t, kLeaseSecretBytes> lease_secret_{};
+  std::int64_t token_sequence_ = 0;
+  base::TimeTicks lease_deadline_tick_;
+
+  // Heartbeat scheduling.
+  int heartbeat_seconds_ = 10;
+  unsigned int consecutive_heartbeat_failures_ = 0;
+  unsigned int start_retries_ = 0;
+
+  // Idempotent retry state for alive (§8 of the protocol).
+  std::string pending_alive_body_;
+  std::int64_t pending_alive_sequence_ = 0;
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  std::unique_ptr<network::SimpleURLLoader> active_loader_;
+
+  base::RepeatingTimer heartbeat_timer_;
+  base::OneShotTimer init_retry_timer_;
+  base::WeakPtrFactory<R0LicenseMonitor> weak_ptr_factory_{this};
+};
+
+}  // namespace r0_license
+
+#endif  // CHROME_BROWSER_R0_LICENSE_R0_LICENSE_MONITOR_H_
