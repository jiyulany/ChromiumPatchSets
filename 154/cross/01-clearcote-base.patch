index 0000000000000..fa2cf1b9240bc
--- /dev/null
+++ b/chrome/browser/r0_license/r0_license_monitor.cc
@@ -0,0 +1,678 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifdef UNSAFE_BUFFERS_BUILD
+// TODO(crbug.com/41496758): Convert pointer arithmetic to base::span.
+#pragma allow_unsafe_buffers
+#endif
+
+#include "chrome/browser/r0_license/r0_license_monitor.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <random>
+#include <string>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/process/process.h"
+#include "base/rand_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/cstring_view.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/r0_license/auth_build_config.h"
+#include "chrome/browser/r0_license/heartbeat_schedule.h"
+#include "chrome/browser/r0_license/install_identity.h"
+#include "content/public/browser/browser_thread.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "third_party/boringssl/src/include/openssl/crypto.h"
+#include "url/gurl.h"
+
+namespace r0_license {
+namespace {
+
+// Switch / environment names.
+constexpr char kSwitchApiKey[] = "r0-api-key";
+constexpr char kSwitchApiBase[] = "r0-api-base";
+constexpr char kEnvApiKey[] = "R0_API_KEY";
+constexpr char kEnvApiBase[] = "R0_API_BASE";
+
+// Server endpoints.
+constexpr char kStartPath[] = "/api/v1/client/api-key-leases/start";
+constexpr char kAlivePath[] = "/api/v1/client/api-key-leases/alive";
+constexpr char kEndPath[] = "/api/v1/client/api-key-leases/end";
+
+// Network and timing.
+constexpr int kMaxStartRetries = 3;            // start only.
+constexpr int kMaxInitAttempts = 10;           // ~20 s wait for URL factory.
+constexpr base::TimeDelta kInitStartDelay = base::Seconds(3);
+constexpr base::TimeDelta kInitPollInterval = base::Seconds(2);
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(10);
+
+std::string TrimTrailingSlash(std::string url) {
+  while (!url.empty() && url.back() == '/') url.pop_back();
+  return url;
+}
+
+std::optional<std::string> GetSwitchOrEnv(const std::string& switch_name,
+                                          base::cstring_view env_name) {
+  auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(switch_name)) {
+    std::string value = cmd->GetSwitchValueASCII(switch_name);
+    if (!value.empty()) return value;
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (env) {
+    std::optional<std::string> value = env->GetVar(env_name);
+    if (value && !value->empty()) return value;
+  }
+  return std::nullopt;
+}
+
+bool ValidateApiBase(const std::string& base, std::string* error) {
+  GURL url(base);
+  if (!url.is_valid() || url.has_query() || url.has_ref() ||
+      url.has_username() || url.has_password() || !url.has_host()) {
+    if (error) *error = "the configured authorization service URL is invalid";
+    return false;
+  }
+  if (!url.SchemeIs("https")) {
+    if (error) *error = "production authorization requires HTTPS";
+    return false;
+  }
+  return true;
+}
+
+int RandomJitterPermille(int max_abs) {
+  static std::mt19937 generator([] {
+    std::random_device source;
+    std::seed_seq seed{source(), source(),
+                       static_cast<unsigned int>(base::GetCurrentProcId()),
+                       static_cast<unsigned int>(
+                           base::Time::Now().InMillisecondsSinceUnixEpoch())};
+    return std::mt19937(seed);
+  }());
+  std::uniform_int_distribution<int> distribution(-max_abs, max_abs);
+  return distribution(generator);
+}
+
+constexpr net::NetworkTrafficAnnotationTag kLeaseTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("r0_license_lease", R"(
+        semantics {
+          sender: "R0Browser API Key Lease Monitor"
+          description:
+            "Periodically reports a per-process instance id and HMAC-signed "
+            "lease proof to the r0browser authorization service. The browser "
+            "forwards the API key only at startup; subsequent heartbeats use "
+            "an Ed25519-signed token."
+          data: "Ed25519-signed lease token, lease secret HMAC proof, "
+                "16-byte nonce, monotonic lease sequence, install/instance "
+                "identifiers, platform and client version."
+          destination: OTHER
+          user_data {
+            type: NONE
+          }
+          last_reviewed: "2026-09-17"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Compiled into the customized fingerprint browser and cannot be "
+            "disabled at runtime."
+        })");
+
+}  // namespace
+
+R0LicenseMonitor::R0LicenseMonitor() = default;
+R0LicenseMonitor::~R0LicenseMonitor() = default;
+
+// static
+R0LicenseMonitor* R0LicenseMonitor::GetInstance() {
+  static R0LicenseMonitor* instance = new R0LicenseMonitor();
+  return instance;
+}
+
+void R0LicenseMonitor::Start() {
+  if (started_) return;
+  started_ = true;
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&R0LicenseMonitor::TryInit,
+                     weak_ptr_factory_.GetWeakPtr(), 0),
+      kInitStartDelay);
+}
+
+void R0LicenseMonitor::Shutdown() {
+  if (!valid_ || closing_) {
+    // Nothing to clean up; let the process exit and the TTL expire server-side.
+    return;
+  }
+  closing_ = true;
+  heartbeat_timer_.Stop();
+  SendEndLease();
+}
+
+void R0LicenseMonitor::TryInit(int attempt) {
+  if (closing_) return;
+  if (!g_browser_process || !g_browser_process->shared_url_loader_factory()) {
+    if (attempt < kMaxInitAttempts) {
+      init_retry_timer_.Start(
+          FROM_HERE, kInitPollInterval,
+          base::BindOnce(&R0LicenseMonitor::TryInit,
+                         weak_ptr_factory_.GetWeakPtr(), attempt + 1));
+      return;
+    }
+    HandleFatal("browser network context was never ready");
+    return;
+  }
+  InitOnUiThread();
+}
+
+void R0LicenseMonitor::InitOnUiThread() {
+  if (closing_) return;
+  if (!ResolveApiKey()) {
+    HandleFatal(
+        "missing or invalid API key. Use --r0-api-key or R0_API_KEY.");
+    return;
+  }
+  api_key_hash_ = Sha256Hex(api_key_);
+  if (api_key_hash_.empty()) {
+    HandleFatal("unable to hash API key");
+    return;
+  }
+  std::string public_key_error;
+  if (!ValidateEd25519PublicKeyConfig(
+          R0_AUTH_ED25519_PUBLIC_KEY_X509_BASE64, &public_key_error)) {
+    HandleFatal("embedded authorization public key is invalid: " +
+                public_key_error);
+    return;
+  }
+  if (!ResolveApiBase()) {
+    HandleFatal("missing or invalid API base URL");
+    return;
+  }
+  std::string install_error;
+  if (!LoadOrCreateInstallId(&install_id_, &install_error)) {
+    HandleFatal("install identity: " + install_error);
+    return;
+  }
+  GenerateInstanceId();
+  if (instance_id_.empty()) {
+    HandleFatal("unable to generate a process instance identity");
+    return;
+  }
+
+  // Secure-clear api_key now that its hash is derived.
+  OPENSSL_cleanse(const_cast<char*>(api_key_.data()), api_key_.size());
+  api_key_.clear();
+
+  LOG(INFO) << "[r0_license] starting lease against " << api_base_
+            << " install_id=" << install_id_
+            << " instance_id=" << instance_id_;
+
+  StartLease();
+}
+
+bool R0LicenseMonitor::ResolveApiKey() {
+  std::optional<std::string> value = GetSwitchOrEnv(kSwitchApiKey, kEnvApiKey);
+  if (!value || value->empty() || value->size() > 500) return false;
+  api_key_ = *value;
+  return true;
+}
+
+bool R0LicenseMonitor::ResolveApiBase() {
+  std::string value = R0_AUTH_PRODUCTION_API_BASE;
+  std::optional<std::string> override =
+      GetSwitchOrEnv(kSwitchApiBase, kEnvApiBase);
+  if (override && !override->empty()) value = *override;
+  value = TrimTrailingSlash(value);
+  std::string err;
+  if (!ValidateApiBase(value, &err)) {
+    LOG(ERROR) << "[r0_license] " << err << ": " << value;
+    return false;
+  }
+  api_base_ = value;
+  url_loader_factory_ = g_browser_process->shared_url_loader_factory();
+  if (!url_loader_factory_) {
+    LOG(ERROR) << "[r0_license] URL loader factory not available";
+    return false;
+  }
+  return true;
+}
+
+void R0LicenseMonitor::GenerateInstanceId() {
+  instance_id_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+void R0LicenseMonitor::StartLease() {
+  if (closing_) return;
+  base::DictValue dict;
+  dict.Set("api_key", api_key_);
+  dict.Set("install_id", install_id_);
+  dict.Set("instance_id", instance_id_);
+  dict.Set("platform", R0_AUTH_PLATFORM);
+  dict.Set("version", R0_AUTH_CLIENT_VERSION);
+  std::string body;
+  if (!base::JSONWriter::Write(dict, &body) || body.empty()) {
+    HandleFatal("unable to serialize start request body");
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(api_base_ + kStartPath);
+  request->method = "POST";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Content-Type", "application/json");
+  request->headers.SetHeader("Accept", "application/json");
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kLeaseTrafficAnnotation);
+  loader->AttachStringForUpload(body, "application/json");
+  loader->SetTimeoutDuration(kRequestTimeout);
+  loader->SetAllowHttpErrorResults(false);
+  loader->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&R0LicenseMonitor::OnStartResponse,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kMaxResponseBytes);
+  active_loader_ = std::move(loader);
+}
+
+void R0LicenseMonitor::OnStartResponse(std::optional<std::string> body) {
+  active_loader_.reset();
+  if (closing_) return;
+
+  if (!body) {
+    // Retryable: brief backoff and try up to kMaxStartRetries.
+    if (start_retries_ < kMaxStartRetries) {
+      const int delay_ms = 250 << start_retries_;
+      ++start_retries_;
+      content::GetUIThreadTaskRunner({})->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&R0LicenseMonitor::StartLease,
+                         weak_ptr_factory_.GetWeakPtr()),
+          base::Milliseconds(delay_ms));
+      return;
+    }
+    HandleFatal(
+        "the authorization service is temporarily unavailable; the API key "
+        "was not rejected");
+    return;
+  }
+  start_retries_ = 0;
+
+  // Validate Content-Type / size before trusting the body.
+  // SimpleURLLoader does not currently surface Content-Type via the
+  // std::string overload; size cap was enforced by DownloadToString.
+  if (body->size() > kMaxResponseBytes) {
+    HandleFatal("the authorization service returned an oversized response");
+    return;
+  }
+
+  auto parsed = base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    HandleFatal("the authorization service returned malformed JSON");
+    return;
+  }
+  std::optional<bool> valid_opt = parsed->FindBool("valid");
+  if (!valid_opt) {
+    HandleFatal("the authorization service response is missing the valid flag");
+    return;
+  }
+  if (!*valid_opt) {
+    HandleFatal("the API key or its entitlement was rejected");
+    return;
+  }
+
+  const std::string* lease_id_ptr = parsed->FindString("lease_id");
+  const std::string* token_ptr = parsed->FindString("token");
+  const std::string* secret_ptr = parsed->FindString("lease_secret");
+  if (!lease_id_ptr || lease_id_ptr->empty() || lease_id_ptr->size() > 64 ||
+      !token_ptr || !secret_ptr) {
+    HandleFatal("the authorization service returned an incomplete lease");
+    return;
+  }
+
+  std::array<std::uint8_t, kLeaseSecretBytes> secret{};
+  if (!DecodeLeaseSecret(*secret_ptr, &secret)) {
+    HandleFatal("the authorization service returned an invalid lease secret");
+    return;
+  }
+  OPENSSL_cleanse(const_cast<char*>(secret_ptr->data()), secret_ptr->size());
+
+  std::optional<int> heartbeat_opt = parsed->FindInt("heartbeat_interval_seconds");
+  if (!heartbeat_opt || *heartbeat_opt < 1 || *heartbeat_opt > 24 * 60 * 60) {
+    HandleFatal("the authorization service returned an invalid heartbeat interval");
+    return;
+  }
+  std::optional<int> seq_opt = parsed->FindInt("token_sequence");
+  if (!seq_opt || *seq_opt < 1) {
+    HandleFatal("the authorization service returned an invalid token sequence");
+    return;
+  }
+
+  const std::uint64_t now_unix = UnixTimeMilliseconds();
+  VerificationContext ctx{
+      api_key_hash_, *lease_id_ptr, install_id_, instance_id_,
+      R0_AUTH_PLATFORM, R0_AUTH_CLIENT_VERSION,
+      static_cast<std::int64_t>(*seq_opt), now_unix};
+  VerifiedToken verified;
+  std::string verify_error;
+  if (!VerifyLeaseToken(*token_ptr, R0_AUTH_ED25519_PUBLIC_KEY_X509_BASE64,
+                        ctx, &verified, &verify_error)) {
+    HandleFatal("the signed lease token failed verification: " + verify_error);
+    return;
+  }
+
+  // Commit lease state and arm the first heartbeat.
+  lease_id_ = *lease_id_ptr;
+  token_ = *token_ptr;
+  lease_secret_ = secret;
+  OPENSSL_cleanse(secret.data(), secret.size());
+  token_sequence_ = verified.sequence;
+  heartbeat_seconds_ = heartbeat::NormalizeSeconds(
+      *heartbeat_opt, heartbeat::kDefaultHeartbeatSeconds);
+  valid_ = true;
+
+  // Translate the verified wall-clock expiry into a monotonic tick deadline.
+  // Reserve the gap between issued_at and now so a clock skew never inflates
+  // the lease beyond what the server actually signed.
+  const std::uint64_t max_remaining_ms =
+      verified.expires_at_unix_ms - verified.issued_at_unix_ms;
+  const std::uint64_t remaining_ms = std::min(
+      verified.expires_at_unix_ms - now_unix, max_remaining_ms);
+  lease_deadline_tick_ = base::TimeTicks::Now() +
+                          base::Milliseconds(
+                              static_cast<std::int64_t>(remaining_ms));
+
+  pending_alive_body_.clear();
+  pending_alive_sequence_ = 0;
+  consecutive_heartbeat_failures_ = 0;
+
+  if (!ScheduleRegularHeartbeat()) {
+    HandleFatal("the signed license lease is already expired");
+  }
+}
+
+bool R0LicenseMonitor::ScheduleRegularHeartbeat() {
+  if (!valid_) return false;
+  const base::TimeDelta remaining = lease_deadline_tick_ - base::TimeTicks::Now();
+  const std::uint64_t remaining_ms =
+      remaining.is_negative() ? 0ULL : static_cast<std::uint64_t>(remaining.InMilliseconds());
+  if (remaining_ms == 0) return false;
+  const std::uint32_t delay_ms = heartbeat::RegularDelayForRemainingMs(
+      heartbeat_seconds_, remaining_ms,
+      RandomJitterPermille(heartbeat::kRegularJitterPermille));
+  if (delay_ms == 0) return false;
+  heartbeat_timer_.Start(FROM_HERE, base::Milliseconds(delay_ms),
+                         base::BindRepeating(&R0LicenseMonitor::HeartbeatTick,
+                                             weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void R0LicenseMonitor::HeartbeatTick() {
+  if (closing_ || !valid_) return;
+  const base::TimeDelta remaining = lease_deadline_tick_ - base::TimeTicks::Now();
+  if (remaining.is_negative() || remaining.is_zero()) {
+    HandleFatal("the signed license lease expired before the next heartbeat");
+    return;
+  }
+  if (!BeginHeartbeat()) {
+    ++consecutive_heartbeat_failures_;
+    if (!ScheduleHeartbeatRetry()) {
+      HandleFatal(
+          "the heartbeat could not be started before signed expiry");
+    }
+  }
+}
+
+bool R0LicenseMonitor::BeginHeartbeat() {
+  if (!valid_) return false;
+  if (pending_alive_body_.empty()) {
+    LeaseProof proof;
+    if (!CreateLeaseProof("alive", lease_id_, install_id_, instance_id_,
+                          token_sequence_ + 1, token_, lease_secret_,
+                          &proof)) {
+      return false;
+    }
+    base::DictValue dict;
+    dict.Set("token", token_);
+    dict.Set("install_id", install_id_);
+    dict.Set("instance_id", instance_id_);
+    dict.Set("lease_id", lease_id_);
+    dict.Set("sequence", static_cast<int>(proof.sequence));
+    dict.Set("nonce", proof.nonce);
+    dict.Set("proof", proof.proof);
+    if (!base::JSONWriter::Write(dict, &pending_alive_body_)) {
+      pending_alive_body_.clear();
+      return false;
+    }
+    pending_alive_sequence_ = proof.sequence;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(api_base_ + kAlivePath);
+  request->method = "POST";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Content-Type", "application/json");
+  request->headers.SetHeader("Accept", "application/json");
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kLeaseTrafficAnnotation);
+  loader->AttachStringForUpload(pending_alive_body_, "application/json");
+  loader->SetTimeoutDuration(kRequestTimeout);
+  loader->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&R0LicenseMonitor::OnHeartbeatResponse,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kMaxResponseBytes);
+  active_loader_ = std::move(loader);
+  return true;
+}
+
+void R0LicenseMonitor::OnHeartbeatResponse(
+    std::optional<std::string> body) {
+  active_loader_.reset();
+  if (closing_) return;
+
+  if (!body) {
+    // Network error or timeout: keep pending_alive_body so the next retry
+    // re-sends the exact same JSON (protocol §8 idempotency).
+    ++consecutive_heartbeat_failures_;
+    if (!ScheduleHeartbeatRetry()) {
+      HandleFatal(
+          "the heartbeat could not be renewed before signed expiry");
+    }
+    return;
+  }
+
+  if (body->size() > kMaxResponseBytes) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the authorization service returned an oversized response");
+    return;
+  }
+
+  auto parsed = base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the authorization service returned malformed JSON");
+    return;
+  }
+
+  std::optional<bool> valid_opt = parsed->FindBool("valid");
+  if (!valid_opt || !*valid_opt) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("lease renewal was rejected");
+    return;
+  }
+  const std::string* token_ptr = parsed->FindString("token");
+  std::optional<int> seq_opt = parsed->FindInt("token_sequence");
+  std::optional<int> heartbeat_opt = parsed->FindInt("heartbeat_interval_seconds");
+  if (!token_ptr || !seq_opt || !heartbeat_opt) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the authorization service returned an incomplete renewal");
+    return;
+  }
+  if (static_cast<std::int64_t>(*seq_opt) != pending_alive_sequence_) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the renewal token sequence does not match our request");
+    return;
+  }
+  if (*heartbeat_opt < 1 || *heartbeat_opt > 24 * 60 * 60) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the renewal heartbeat interval is invalid");
+    return;
+  }
+
+  const std::uint64_t now_unix = UnixTimeMilliseconds();
+  VerificationContext ctx{
+      api_key_hash_, lease_id_, install_id_, instance_id_,
+      R0_AUTH_PLATFORM, R0_AUTH_CLIENT_VERSION,
+      pending_alive_sequence_, now_unix};
+  VerifiedToken verified;
+  std::string verify_error;
+  if (!VerifyLeaseToken(*token_ptr, R0_AUTH_ED25519_PUBLIC_KEY_X509_BASE64,
+                        ctx, &verified, &verify_error)) {
+    OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                    pending_alive_body_.size());
+    pending_alive_body_.clear();
+    HandleFatal("the renewed lease token failed verification: " + verify_error);
+    return;
+  }
+
+  // Commit new lease state and clear the in-flight body (success path).
+  token_ = *token_ptr;
+  // lease_secret_ is bound to a single lease and persists across renewals
+  // until the next start; the demo reference behaves identically.
+  token_sequence_ = verified.sequence;
+  heartbeat_seconds_ = heartbeat::NormalizeSeconds(
+      *heartbeat_opt, heartbeat_seconds_);
+  consecutive_heartbeat_failures_ = 0;
+
+  const std::uint64_t max_remaining_ms =
+      verified.expires_at_unix_ms - verified.issued_at_unix_ms;
+  const std::uint64_t remaining_ms = std::min(
+      verified.expires_at_unix_ms - now_unix, max_remaining_ms);
+  lease_deadline_tick_ = base::TimeTicks::Now() +
+                          base::Milliseconds(static_cast<int64_t>(remaining_ms));
+
+  OPENSSL_cleanse(const_cast<char*>(pending_alive_body_.data()),
+                  pending_alive_body_.size());
+  pending_alive_body_.clear();
+  pending_alive_sequence_ = 0;
+
+  if (closing_) {
+    BeginClose();
+  } else if (!ScheduleRegularHeartbeat()) {
+    HandleFatal("the signed license lease has expired");
+  }
+}
+
+bool R0LicenseMonitor::ScheduleHeartbeatRetry() {
+  if (!valid_) return false;
+  const base::TimeDelta remaining = lease_deadline_tick_ - base::TimeTicks::Now();
+  const std::uint64_t remaining_ms =
+      remaining.is_negative() ? 0ULL : static_cast<std::uint64_t>(remaining.InMilliseconds());
+  const auto plan = heartbeat::RetryDelayForRemainingMs(
+      consecutive_heartbeat_failures_, heartbeat_seconds_, remaining_ms,
+      RandomJitterPermille(heartbeat::kRetryJitterPermille));
+  if (!plan.should_retry) return false;
+  heartbeat_timer_.Start(
+      FROM_HERE, base::Milliseconds(plan.delay_ms),
+      base::BindRepeating(&R0LicenseMonitor::HeartbeatTick,
+                          weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void R0LicenseMonitor::BeginClose() {
+  if (closing_) return;
+  closing_ = true;
+  heartbeat_timer_.Stop();
+  valid_ = false;
+  SendEndLease();
+}
+
+void R0LicenseMonitor::SendEndLease() {
+  if (lease_id_.empty()) return;
+  if (active_loader_) return;
+  LeaseProof proof;
+  if (!CreateLeaseProof("end", lease_id_, install_id_, instance_id_,
+                        token_sequence_ + 1, token_, lease_secret_, &proof)) {
+    return;
+  }
+  base::DictValue dict;
+  dict.Set("token", token_);
+  dict.Set("install_id", install_id_);
+  dict.Set("instance_id", instance_id_);
+  dict.Set("lease_id", lease_id_);
+  dict.Set("sequence", static_cast<int>(proof.sequence));
+  dict.Set("nonce", proof.nonce);
+  dict.Set("proof", proof.proof);
+  std::string body;
+  if (!base::JSONWriter::Write(dict, &body)) return;
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(api_base_ + kEndPath);
+  request->method = "POST";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Content-Type", "application/json");
+  request->headers.SetHeader("Accept", "application/json");
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kLeaseTrafficAnnotation);
+  loader->AttachStringForUpload(body, "application/json");
+  loader->SetTimeoutDuration(kRequestTimeout);
+  // Best effort: don't keep the user waiting on shutdown for an end ack.
+  loader->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&R0LicenseMonitor::OnEndResponse,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kMaxResponseBytes);
+  active_loader_ = std::move(loader);
+}
+
+void R0LicenseMonitor::OnEndResponse(std::optional<std::string> body) {
+  active_loader_.reset();
+  // End is best-effort. Either accepted or not, we are shutting down.
+}
+
+void R0LicenseMonitor::HandleFatal(const std::string& reason) {
+  LOG(ERROR) << "[r0_license] FATAL: " << reason;
+  closing_ = true;
+  valid_ = false;
+  heartbeat_timer_.Stop();
+  base::Process::TerminateCurrentProcessImmediately(1);
+}
+
+}  // namespace r0_license
