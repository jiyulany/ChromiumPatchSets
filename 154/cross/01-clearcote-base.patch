+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_R0_LICENSE_HEARTBEAT_SCHEDULE_H_
+#define CHROME_BROWSER_R0_LICENSE_HEARTBEAT_SCHEDULE_H_
+
+#include <algorithm>
+#include <cstdint>
+
+// Heartbeat scheduling primitives ported from the r0browser-auth-shell
+// reference implementation. The algorithm schedules against the
+// cryptographically verified token expiry (rather than the informational
+// lease_ttl_seconds field) and bounds retries inside the remaining lease
+// window so we never deliver a request after the last verified expiry.
+
+namespace r0_license {
+namespace heartbeat {
+
+constexpr int kDefaultHeartbeatSeconds = 10;
+constexpr int kDefaultLeaseTtlSeconds = 30;
+constexpr int kRegularJitterPermille = 150;  // +/- 15%.
+constexpr int kRetryJitterPermille = 200;    // +/- 20%.
+
+struct RetryPlan {
+  bool should_retry = false;
+  std::uint32_t delay_ms = 0;
+};
+
+inline int NormalizeSeconds(int value, int fallback) {
+  return value >= 1 && value <= 24 * 60 * 60 ? value : fallback;
+}
+
+inline std::uint64_t Milliseconds(int seconds, int fallback) {
+  return static_cast<std::uint64_t>(NormalizeSeconds(seconds, fallback)) *
+         1000ULL;
+}
+
+// Reserves headroom so the next HTTP request can actually run before the lease
+// deadline. With a 30 s lease we reserve 5 s; shorter leases reserve 500 ms.
+inline std::uint64_t AttemptReserveMs(std::uint64_t ttl_ms) {
+  return std::clamp<std::uint64_t>(ttl_ms / 4ULL, 500ULL, 5000ULL);
+}
+
+inline std::uint64_t ApplyJitter(std::uint64_t value_ms, int jitter_permille,
+                                 int maximum_absolute_permille) {
+  const int bounded = std::clamp(jitter_permille, -maximum_absolute_permille,
+                                 maximum_absolute_permille);
+  return value_ms *
+         static_cast<std::uint64_t>(1000 + bounded) / 1000ULL;
+}
+
+inline std::uint32_t RegularDelayForRemainingMs(int heartbeat_seconds,
+                                                std::uint64_t remaining_ms,
+                                                int jitter_permille) {
+  if (remaining_ms == 0) return 0;
+  const std::uint64_t heartbeat_ms =
+      Milliseconds(heartbeat_seconds, kDefaultHeartbeatSeconds);
+  const std::uint64_t reserve_ms = AttemptReserveMs(remaining_ms);
+  if (remaining_ms <= reserve_ms) return 1;
+  const std::uint64_t jittered_ms =
+      ApplyJitter(heartbeat_ms, jitter_permille, kRegularJitterPermille);
+  return static_cast<std::uint32_t>(std::max<std::uint64_t>(
+      1ULL, std::min(jittered_ms, remaining_ms - reserve_ms)));
+}
+
+inline RetryPlan RetryDelayForRemainingMs(unsigned int consecutive_failures,
+                                          int heartbeat_seconds,
+                                          std::uint64_t remaining_ms,
+                                          int jitter_permille) {
+  const std::uint64_t reserve_ms = AttemptReserveMs(remaining_ms);
+  if (consecutive_failures == 0 || remaining_ms <= reserve_ms) return {};
+  const std::uint64_t heartbeat_ms =
+      Milliseconds(heartbeat_seconds, kDefaultHeartbeatSeconds);
+  const unsigned int shift = std::min(consecutive_failures - 1U, 3U);
+  const std::uint64_t exponential_ms = 500ULL << shift;
+  const std::uint64_t retry_cap_ms =
+      std::min<std::uint64_t>(
+          4000ULL, std::max<std::uint64_t>(1000ULL, heartbeat_ms / 2ULL));
+  const std::uint64_t jittered_ms =
+      ApplyJitter(std::min(exponential_ms, retry_cap_ms), jitter_permille,
+                  kRetryJitterPermille);
+  const std::uint64_t delay = std::max<std::uint64_t>(
+      1ULL, std::min(jittered_ms, remaining_ms - reserve_ms));
+  return {true, static_cast<std::uint32_t>(delay)};
+}
+
+}  // namespace heartbeat
+}  // namespace r0_license
+
+#endif  // CHROME_BROWSER_R0_LICENSE_HEARTBEAT_SCHEDULE_H_
