+#include "third_party/boringssl/src/include/openssl/crypto.h"
+#include "third_party/boringssl/src/include/openssl/digest.h"
+#include "third_party/boringssl/src/include/openssl/evp.h"
+#include "third_party/boringssl/src/include/openssl/hmac.h"
+#include "third_party/boringssl/src/include/openssl/rand.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace r0_license {
+namespace {
+
+// Standard X.509 SubjectPublicKeyInfo prefix for Ed25519 (RFC 8410):
+//   SEQUENCE { ... } = 0x30 0x2a
+//     SEQUENCE { OID 1.3.101.112 } = 0x30 0x05 0x06 0x03 0x2b 0x65 0x70
+//     BIT STRING (32 zero bits header + 32-byte key) = 0x03 0x21 0x00 <key>
+constexpr std::size_t kX509PrefixSize = 12;
+const std::uint8_t kX509Ed25519Prefix[kX509PrefixSize] = {
+    0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00};
+
+constexpr std::array<std::string_view, 14> kExpectedClaims = {
+    "api_key_hash", "aud",      "expires_at", "install_id", "instance_id",
+    "iss",          "issued_at", "kid",       "lease_id",   "plan",
+    "platform",     "seq",       "ver",       "version"};
+
+constexpr std::uint64_t kClockSkewMs = 60 * 1000ULL;
+constexpr std::uint64_t kMaximumLifetimeMs = 24LL * 60 * 60 * 1000;
+
+int Base64Value(char c, bool url) {
+  if (c >= 'A' && c <= 'Z') return c - 'A';
+  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+  if (c >= '0' && c <= '9') return c - '0' + 52;
+  if (c == (url ? '-' : '+')) return 62;
+  if (c == (url ? '_' : '/')) return 63;
+  return -1;
+}
+
+bool Base64DecodeInternal(const std::string& encoded,
+                          bool url,
+                          bool require_no_padding,
+                          std::vector<std::uint8_t>* output) {
+  output->clear();
+  if (encoded.empty() || encoded.size() > kMaxResponseBytes) return false;
+  std::size_t content_size = encoded.size();
+  while (content_size && encoded[content_size - 1] == '=') --content_size;
+  const std::size_t padding = encoded.size() - content_size;
+  if ((require_no_padding && padding != 0) || padding > 2) return false;
+  if (padding && encoded.size() % 4 != 0) return false;
+  if (content_size % 4 == 1) return false;
+  for (std::size_t i = 0; i < content_size; ++i) {
+    if (Base64Value(encoded[i], url) < 0) return false;
+  }
+  const std::size_t expected_padding = (4 - content_size % 4) % 4;
+  if (padding && padding != expected_padding) return false;
+  std::uint32_t accumulator = 0;
+  int bits = 0;
+  for (std::size_t i = 0; i < content_size; ++i) {
+    accumulator = (accumulator << 6) |
+                  static_cast<std::uint32_t>(Base64Value(encoded[i], url));
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      output->push_back(
+          static_cast<std::uint8_t>((accumulator >> bits) & 0xFF));
+    }
+  }
+  if (bits && (accumulator & ((1u << bits) - 1u)) != 0) return false;
+  return true;
+}
+
+bool ReadDigits(const std::string& s, std::size_t pos, std::size_t count,
+                int* out) {
+  if (pos + count > s.size()) return false;
+  *out = 0;
+  for (std::size_t i = 0; i < count; ++i) {
+    char c = s[pos + i];
+    if (c < '0' || c > '9') return false;
+    *out = *out * 10 + (c - '0');
+  }
+  return true;
+}
+
+// Accepts YYYY-MM-DDTHH:MM:SS[.fff]Z or ...+00:00 (1..9 fractional digits).
+bool ParseUtcInstant(const std::string& value, std::uint64_t* unix_ms) {
+  if (value.size() < 22 || value[4] != '-' || value[7] != '-' ||
+      value[10] != 'T' || value[13] != ':' || value[16] != ':' ||
+      value[19] != '.') {
+    return false;
+  }
+  std::size_t frac_end = 0;
+  if (value.back() == 'Z') {
+    frac_end = value.size() - 1;
+  } else if (value.size() >= 6 &&
+             value.compare(value.size() - 6, 6, "+00:00") == 0) {
+    frac_end = value.size() - 6;
+  } else {
+    return false;
+  }
+  if (frac_end < 21 || frac_end > 29) return false;
+  int year, month, day, hour, minute, second;
+  if (!ReadDigits(value, 0, 4, &year) ||
+      !ReadDigits(value, 5, 2, &month) ||
+      !ReadDigits(value, 8, 2, &day) ||
+      !ReadDigits(value, 11, 2, &hour) ||
+      !ReadDigits(value, 14, 2, &minute) ||
+      !ReadDigits(value, 17, 2, &second)) {
+    return false;
+  }
+  int ms = 0;
+  for (std::size_t i = 20; i < frac_end; ++i) {
+    if (!std::isdigit(static_cast<unsigned char>(value[i]))) return false;
+    if (i < 23) ms = ms * 10 + (value[i] - '0');
+  }
+  for (std::size_t i = frac_end - 20; i < 3; ++i) ms *= 10;
+  base::Time::Exploded exploded{};
+  exploded.year = year;
+  exploded.month = month;
+  exploded.day_of_month = day;
+  exploded.hour = hour;
+  exploded.minute = minute;
+  exploded.second = second;
+  exploded.millisecond = ms;
+  base::Time t;
+  if (!base::Time::FromUTCExploded(exploded, &t)) return false;
+  *unix_ms = static_cast<std::uint64_t>(t.InMillisecondsSinceUnixEpoch());
+  return true;
+}
+
+bool ExactString(const base::DictValue& d, const char* key,
+                 const std::string& expected) {
+  const std::string* v = d.FindString(key);
+  return v && *v == expected;
+}
+
+}  // namespace
+
+bool SecureRandomBytes(std::uint8_t* output, std::size_t size) {
+  if (size > std::numeric_limits<int>::max()) return false;
+  return RAND_bytes(output, static_cast<int>(size)) == 1;
+}
+
+bool Sha256(const std::uint8_t* bytes, std::size_t size,
+            std::array<std::uint8_t, 32>* output) {
+  if (size > std::numeric_limits<size_t>::max()) return false;
+  ::SHA256(bytes, size, output->data());
+  return true;
+}
+
+std::string Sha256Hex(const std::string& input) {
+  std::array<std::uint8_t, 32> digest{};
+  if (!Sha256(reinterpret_cast<const std::uint8_t*>(input.data()),
+              input.size(), &digest)) {
+    return {};
+  }
+  static const char hex[] = "0123456789abcdef";
+  std::string out(64, '0');
+  for (std::size_t i = 0; i < digest.size(); ++i) {
+    out[i * 2] = hex[digest[i] >> 4];
+    out[i * 2 + 1] = hex[digest[i] & 0xF];
+  }
+  return out;
+}
+
+bool HmacSha256(const std::uint8_t* key, std::size_t key_size,
+                const std::string& input,
+                std::array<std::uint8_t, 32>* output) {
+  if (key_size > std::numeric_limits<unsigned int>::max()) return false;
+  if (input.size() > std::numeric_limits<unsigned int>::max()) return false;
+  unsigned int len = 0;
+  const auto* result = ::HMAC(
+      EVP_sha256(), key, static_cast<unsigned int>(key_size),
+      reinterpret_cast<const std::uint8_t*>(input.data()),
+      static_cast<unsigned int>(input.size()), output->data(), &len);
+  return result != nullptr && len == output->size();
+}
+
+std::string Base64UrlEncode(const std::uint8_t* bytes, std::size_t size) {
+  static const char alphabet[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+  std::string out;
+  out.reserve((size * 4 + 2) / 3);
+  std::uint32_t accumulator = 0;
+  int bits = 0;
+  for (std::size_t i = 0; i < size; ++i) {
+    accumulator = (accumulator << 8) | bytes[i];
+    bits += 8;
+    while (bits >= 6) {
+      bits -= 6;
+      out.push_back(alphabet[(accumulator >> bits) & 0x3F]);
+    }
+  }
+  if (bits) out.push_back(alphabet[(accumulator << (6 - bits)) & 0x3F]);
+  return out;
+}
+
+bool Base64UrlDecode(const std::string& encoded, bool require_no_padding,
+                     std::vector<std::uint8_t>* output) {
+  return Base64DecodeInternal(encoded, true, require_no_padding, output);
+}
+
+bool DecodeLeaseSecret(const std::string& encoded,
+                       std::array<std::uint8_t, kLeaseSecretBytes>* output) {
+  std::vector<std::uint8_t> decoded;
+  if (!Base64DecodeInternal(encoded, true, true, &decoded) ||
+      decoded.size() != output->size()) {
+    return false;
+  }
+  std::copy(decoded.begin(), decoded.end(), output->begin());
+  OPENSSL_cleanse(decoded.data(), decoded.size());
+  return true;
+}
+
+bool ValidateEd25519PublicKeyConfig(
+    const std::string& public_key_x509_base64,
+    std::string* error) {
+  std::vector<std::uint8_t> der;
+  if (!Base64DecodeInternal(public_key_x509_base64, false, false, &der) ||
+      der.size() != kX509PrefixSize + kPublicKeyRawBytes ||
+      std::memcmp(der.data(), kX509Ed25519Prefix, kX509PrefixSize) != 0) {
+    if (error) *error = "configured key is not Ed25519 X.509 SPKI";
+    return false;
+  }
+  return true;
+}
+
+bool VerifyLeaseToken(const std::string& token,
+                      const std::string& public_key_x509_base64,
+                      const VerificationContext& context,
+                      VerifiedToken* output,
+                      std::string* error) {
+  if (output) *output = VerifiedToken{};
+  if (token.empty() || token.size() > kMaxTokenBytes) {
+    if (error) *error = "invalid token length";
+    return false;
+  }
+  const std::size_t sep = token.find('.');
+  if (sep == std::string::npos ||
+      token.find('.', sep + 1) != std::string::npos) {
+    if (error) *error = "invalid compact token (expected 2 segments)";
+    return false;
+  }
+
+  std::vector<std::uint8_t> payload, signature, x509;
+  if (!Base64DecodeInternal(token.substr(0, sep), true, true, &payload) ||
+      !Base64DecodeInternal(token.substr(sep + 1), true, true, &signature) ||
+      signature.size() != kSignatureBytes ||
+      !Base64DecodeInternal(public_key_x509_base64, false, false, &x509) ||
+      x509.size() != kX509PrefixSize + kPublicKeyRawBytes ||
+      std::memcmp(x509.data(), kX509Ed25519Prefix, kX509PrefixSize) != 0) {
+    if (error) *error = "invalid token encoding or configured Ed25519 key";
+    return false;
+  }
+
+  const std::uint8_t* raw_pubkey = x509.data() + kX509PrefixSize;
+  EVP_PKEY* pkey = EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr,
+                                                raw_pubkey,
+                                                kPublicKeyRawBytes);
+  if (!pkey) {
+    if (error) *error = "unable to load Ed25519 public key";
+    return false;
+  }
+  EVP_MD_CTX* md_ctx = EVP_MD_CTX_new();
+  if (!md_ctx) {
+    EVP_PKEY_free(pkey);
+    if (error) *error = "unable to allocate EVP_MD_CTX";
+    return false;
+  }
+  int verify_init = EVP_DigestVerifyInit(md_ctx, nullptr, nullptr, nullptr,
+                                          pkey);
+  int verify_rc = -1;
+  if (verify_init == 1) {
+    verify_rc = EVP_DigestVerify(md_ctx, signature.data(),
+                                  signature.size(), payload.data(),
+                                  payload.size());
+  }
+  EVP_MD_CTX_free(md_ctx);
+  EVP_PKEY_free(pkey);
+  if (verify_init != 1 || verify_rc != 1) {
+    if (error) *error = "invalid token signature";
+    return false;
+  }
+
+  std::string payload_json(payload.begin(), payload.end());
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      payload_json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    if (error) *error = "token payload is not a JSON object";
+    return false;
+  }
+  const base::DictValue& claims = parsed->GetDict();
+  if (claims.size() != kExpectedClaims.size()) {
+    if (error) *error = "token has missing or extra claims";
+    return false;
+  }
+  for (const auto kv : claims) {
+    if (std::find(kExpectedClaims.begin(), kExpectedClaims.end(), kv.first) ==
+        kExpectedClaims.end()) {
+      if (error) *error = "token has an unsupported claim";
+      return false;
+    }
+  }
+
+  std::array<std::uint8_t, 32> key_hash{};
+  if (!Sha256(x509.data(), x509.size(), &key_hash)) {
+    if (error) *error = "unable to hash configured public key";
+    return false;
+  }
+  const std::string expected_kid = Base64UrlEncode(key_hash.data(), 12);
+
+  std::int64_t sequence = 0;
+  const std::string* issued = claims.FindString("issued_at");
+  const std::string* expires = claims.FindString("expires_at");
+  const std::string* plan = claims.FindString("plan");
+
+  std::optional<int> ver_opt = claims.FindInt("ver");
+  std::optional<int> seq_opt = claims.FindInt("seq");
+  VerifiedToken verified;
+  const bool claims_ok =
+      ver_opt.has_value() && *ver_opt == 2 && seq_opt.has_value() &&
+      *seq_opt >= 1 &&
+      static_cast<std::int64_t>(*seq_opt) !=
+          std::numeric_limits<std::int64_t>::max() &&
+      (context.expected_sequence <= 0 ||
+       static_cast<std::int64_t>(*seq_opt) == context.expected_sequence) &&
+      ExactString(claims, "iss", "r0browser-license") &&
+      ExactString(claims, "aud", "r0browser-client") &&
+      ExactString(claims, "kid", expected_kid) &&
+      ExactString(claims, "api_key_hash", context.api_key_hash) &&
+      ExactString(claims, "lease_id", context.lease_id) &&
+      ExactString(claims, "install_id", context.install_id) &&
+      ExactString(claims, "instance_id", context.instance_id) &&
+      ExactString(claims, "platform", context.platform) &&
+      ExactString(claims, "version", context.client_version) &&
+      issued != nullptr && expires != nullptr && plan != nullptr &&
+      !plan->empty() && plan->size() <= 100 &&
+      ParseUtcInstant(*issued, &verified.issued_at_unix_ms) &&
+      ParseUtcInstant(*expires, &verified.expires_at_unix_ms);
+  if (!claims_ok) {
+    if (error) *error = "token claims do not match this lease";
+    return false;
+  }
+  sequence = static_cast<std::int64_t>(*seq_opt);
+
+  if (verified.expires_at_unix_ms <= context.now_unix_ms ||
+      verified.issued_at_unix_ms > context.now_unix_ms + kClockSkewMs ||
+      context.now_unix_ms >
+          verified.issued_at_unix_ms + kClockSkewMs ||
+      verified.expires_at_unix_ms <= verified.issued_at_unix_ms ||
+      verified.expires_at_unix_ms - verified.issued_at_unix_ms >
+          kMaximumLifetimeMs) {
+    if (error) *error = "token is expired or has invalid timestamps";
+    return false;
+  }
+  verified.sequence = sequence;
+  if (output) *output = verified;
+  return true;
+}
+
+bool CreateLeaseProof(const std::string& operation,
+                      const std::string& lease_id,
+                      const std::string& install_id,
+                      const std::string& instance_id,
+                      std::int64_t next_sequence,
+                      const std::string& token,
+                      const std::array<std::uint8_t, kLeaseSecretBytes>& secret,
+                      LeaseProof* output) {
+  if (!output) return false;
+  if ((operation != "alive" && operation != "end") || next_sequence < 1) {
+    return false;
+  }
+  std::array<std::uint8_t, kNonceBytes> nonce{};
+  if (!SecureRandomBytes(nonce.data(), nonce.size())) return false;
+  output->nonce = Base64UrlEncode(nonce.data(), nonce.size());
+
+  const std::string token_hash = Sha256Hex(token);
+  if (token_hash.empty()) return false;
+
+  std::string canonical;
+  canonical.reserve(64 + lease_id.size() + install_id.size() +
+                    instance_id.size() + token_hash.size());
+  canonical.append("r0-lease-proof-v1\n");
+  canonical.append(operation);
+  canonical.push_back('\n');
+  canonical.append(lease_id);
+  canonical.push_back('\n');
+  canonical.append(install_id);
+  canonical.push_back('\n');
+  canonical.append(instance_id);
+  canonical.push_back('\n');
+  canonical.append(std::to_string(next_sequence));
+  canonical.push_back('\n');
+  canonical.append(output->nonce);
+  canonical.push_back('\n');
+  canonical.append(token_hash);
+
+  std::array<std::uint8_t, 32> mac{};
+  if (!HmacSha256(secret.data(), secret.size(), canonical, &mac)) return false;
+  output->proof = Base64UrlEncode(mac.data(), mac.size());
+  OPENSSL_cleanse(mac.data(), mac.size());
+  output->sequence = next_sequence;
+  return true;
+}
+
+std::uint64_t UnixTimeMilliseconds() {
+  return static_cast<std::uint64_t>(
+      base::Time::Now().InMillisecondsSinceUnixEpoch());
+}
+
+}  // namespace r0_license
