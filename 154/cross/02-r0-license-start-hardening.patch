 void R0LicenseMonitor::OnStartResponse(std::optional<std::string> body) {
+  // Capture transport/server outcome before releasing the loader.
+  int net_error = net::OK;
+  int http_status = 0;
+  if (active_loader_) {
+    net_error = active_loader_->NetError();
+    const network::mojom::URLResponseHead* head =
+        active_loader_->ResponseInfo();
+    if (head && head->headers) {
+      http_status = head->headers->response_code();
+    }
+  }
+
+  // Transient conditions (transport failure / 408 / 429 / 5xx) are retried
+  // with backoff; any other 4xx is a definitive server rejection.
+  const bool retryable = !body || net_error != net::OK || http_status == 408 ||
+                         http_status == 429 || http_status >= 500;
+
+  // Diagnostics: log the full picture on any non-success outcome. On success
+  // the body contains the lease secret, so it is deliberately not logged.
+  if (retryable || http_status >= 400) {
+    LOG(ERROR) << "[r0_license] start diagnostics: net_error=" << net_error
+               << " http_status=" << http_status << " body="
+               << (body ? *body : std::string("<null>"));
+  }
+
   active_loader_.reset();
   if (closing_) return;
 
