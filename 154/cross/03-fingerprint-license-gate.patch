diff --git a/content/public/browser/fingerprint_authorization.h b/content/public/browser/fingerprint_authorization.h
new file mode 100644
index 0000000..7be1a94
--- /dev/null
+++ b/content/public/browser/fingerprint_authorization.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_BROWSER_FINGERPRINT_AUTHORIZATION_H_
+#define CONTENT_PUBLIC_BROWSER_FINGERPRINT_AUTHORIZATION_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+// ★ Fingerprint license gate (r0 license lease).
+//
+// Every consumer of --fingerprint-config MUST gate on
+// IsFingerprintAuthorized() and behave as if the switch were absent while it
+// returns false. The flag flips to true exactly once, after the r0 license
+// monitor has obtained a lease and verified the Ed25519 token
+// (R0LicenseMonitor, chrome layer). It deliberately never flips back: any
+// subsequent revocation path terminates the process.
+//
+// Rationale: if the authorization-failure exit path is ever patched out by a
+// reverse engineer, the browser keeps running with completely stock
+// fingerprints, which is worthless for the anti-detection use case.
+//
+// The functions live in the content layer (not chrome/) because
+// RenderProcessHostImpl — the most important consumer — is below the
+// chrome/ layering boundary. Thread-safe; may be called from any thread.
+
+// Marks the fingerprint configuration as authorized. Called by the chrome
+// layer once the license lease has been granted and verified.
+CONTENT_EXPORT void SetFingerprintAuthorized();
+
+// Returns true once SetFingerprintAuthorized() has been called.
+CONTENT_EXPORT bool IsFingerprintAuthorized();
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_FINGERPRINT_AUTHORIZATION_H_
