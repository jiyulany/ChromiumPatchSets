+#if !BUILDFLAG(IS_ANDROID)
+namespace {
+
+// ★ Fingerprint license gate (r0 license lease).
+//
+// Initial browser window creation is held until the r0 license lease has
+// been granted and verified (content::IsFingerprintAuthorized). A renderer
+// process launched before the gate opens keeps stock fingerprints for its
+// entire lifetime (its command line is fixed at launch), and the lease flow
+// is asynchronous — so without this hold, the first tabs race the lease and
+// would show the real device fingerprint.
+//
+// A definitive failure (R0LicenseMonitor::HandleFatal) also releases the
+// hold: the fingerprint gate stays closed, so the window then shows a
+// completely stock browser — useful for observing the failure state, and
+// still worthless to anyone who patched out the exit path.
+constexpr base::TimeDelta kStartupWindowGatePollInterval =
+    base::Milliseconds(50);
+
+bool ShouldHoldStartupWindowsForLicenseGate() {
+  // Only hold when a fingerprint config was supplied; without one the
+  // fingerprint gate is irrelevant and startup must not wait.
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+             "fingerprint-config") &&
+         !content::IsFingerprintAuthorized();
+}
+
+void StartStartupWindowsWhenAuthorized(
+    std::unique_ptr<StartupBrowserCreator> creator,
+    StartupProfileInfo profile_info,
+    std::vector<Profile*> last_opened_profiles) {
+  // Release on success (fingerprinted renderers) or on definitive failure
+  // (fingerprint gate stays closed → stock renderers; observable failure
+  // state for testing).
+  if (!content::IsFingerprintAuthorized() &&
+      !r0_license::R0LicenseMonitor::GetInstance()->HasFatalError()) {
+    content::GetUIThreadTaskRunner({})->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&StartStartupWindowsWhenAuthorized, std::move(creator),
+                       profile_info, std::move(last_opened_profiles)),
+        kStartupWindowGatePollInterval);
+    return;
+  }
+  const bool gate_open = content::IsFingerprintAuthorized();
+  LOG(INFO) << "[r0_license] creating initial browser windows ("
+            << (gate_open ? "fingerprint gate open"
+                          : "authorization failed; stock fingerprints")
+            << ")";
+  // Mirrors the non-deferred call site below, including its side effects.
+  if (creator->Start(*base::CommandLine::ForCurrentProcess(), base::FilePath(),
+                     profile_info, last_opened_profiles)) {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+    g_browser_process->StartAutoupdateTimer();
+#endif
+#if BUILDFLAG(IS_LINUX)
+    upgrade_util::SaveLastModifiedTimeOfExe();
+#endif
+    if constexpr (kShouldRecordActiveUse) {
+      GoogleUpdateSettings::SetLastRunTime();
+    }
+  }
+}
+
+}  // namespace
+#endif  // !BUILDFLAG(IS_ANDROID)
