diff --git a/chrome/browser/r0_license/r0_log.h b/chrome/browser/r0_license/r0_log.h
new file mode 100644
index 0000000..f7eb420
--- /dev/null
+++ b/chrome/browser/r0_license/r0_log.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_R0_LICENSE_R0_LOG_H_
+#define CHROME_BROWSER_R0_LICENSE_R0_LOG_H_
+
+#include "base/logging.h"
+
+// Compile-time switch for r0_license diagnostics logging.
+//
+// Default (developer/test builds): R0_LOG is plain LOG(), all authorization
+// diagnostics reach chrome_debug.log / stderr.
+//
+// Production builds (gn arg r0_license_silent_logs = true, which defines
+// R0_LICENSE_SILENT): every R0_LOG stream below expands to
+// EAT_STREAM_PARAMETERS — the same mechanism DLOG uses in release builds.
+// The stream expression becomes compile-time dead code, so the log strings
+// ("[r0_license] FATAL: ...", URL diagnostics, ...) are removed from the
+// binary entirely. Reverse engineers cannot locate the authorization gate
+// by searching for log text, and there is no runtime switch to flip back.
+//
+// Never put security-relevant decisions inside a log stream: in silent
+// builds the stream operands are never evaluated.
+
+#if defined(R0_LICENSE_SILENT)
+
+#define R0_LOG(severity) EAT_STREAM_PARAMETERS
+#define R0_PLOG(severity) EAT_STREAM_PARAMETERS
+
+#else
+
+#define R0_LOG(severity) LOG(severity)
+#define R0_PLOG(severity) PLOG(severity)
+
+#endif  // R0_LICENSE_SILENT
+
+#endif  // CHROME_BROWSER_R0_LICENSE_R0_LOG_H_
