+std::optional<float> GetFingerprintDeviceMemory() {
+  // Browser-side navigation Client Hints must use the same configuration as
+  // navigator.deviceMemory and renderer-generated subresource hints.
+  if (!IsFingerprintAuthorized()) {
+    return std::nullopt;
+  }
+  const std::string config_path =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "fingerprint-config");
+  if (config_path.empty()) {
+    return std::nullopt;
+  }
+  std::string json;
+  if (!base::ReadFileToString(base::FilePath::FromUTF8Unsafe(config_path),
+                              &json)) {
+    return std::nullopt;
+  }
+  auto root = base::JSONReader::ReadDict(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!root) {
+    return std::nullopt;
+  }
+  const base::DictValue* config = root->FindDict("device_memory_fp");
+  if (!config || !config->FindBool("enabled").value_or(false)) {
+    return std::nullopt;
+  }
+  const std::optional<double> value = config->FindDouble("device_memory");
+  if (!value || *value <= 0) {
+    return std::nullopt;
+  }
+  return static_cast<float>(*value);
+}
