 #include "content/public/browser/child_process_host.h"
 #include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/fingerprint_authorization.h"
 #include "content/public/browser/global_routing_id.h"
 #include "content/public/browser/gpu_client.h"
 #include "content/public/browser/isolated_context_util.h"
@@ -3751,6 +3753,54 @@ void RenderProcessHostImpl::AppendRendererCommandLine(
   command_line->AppendSwitchASCII(switches::kProcessType,
                                   switches::kRendererProcess);
 
+  // Pass fingerprint config to Renderer process
+  // Browser reads the file and passes JSON content (Renderer sandbox cannot access files)
+  //
+  // ★ License gate: the config is only honored after the r0 license lease
+  // has been granted and verified (content::SetFingerprintAuthorized). A
+  // renderer launched before authorization keeps stock fingerprints for its
+  // whole lifetime; if the authorization-failure exit path is ever patched
+  // out, no renderer ever receives fingerprint modifications.
+  const base::CommandLine* browser_cmd = base::CommandLine::ForCurrentProcess();
+  if (browser_cmd->HasSwitch("fingerprint-config") &&
+      IsFingerprintAuthorized()) {
+    base::FilePath config_path =
+        browser_cmd->GetSwitchValuePath("fingerprint-config");
+
+    // Read config file content in Browser process (no sandbox restriction)
+    std::string json_content;
+    if (base::ReadFileToString(config_path, &json_content)) {
+      // Pass JSON content directly to Renderer via command line.
+      // Use AppendSwitchUTF8 to preserve non-ASCII characters
+      // (e.g. Chinese voice names in voices_fp).
+      command_line->AppendSwitchUTF8("fingerprint-json", json_content);
+      LOG(INFO) << "[Fingerprint] Passed config to Renderer: "
+                << config_path.value() << " (" << json_content.length()
+                << " bytes)";
+
+      // ★ CDP detection evasion: if cdp_fp.enabled, pass --js-flags so the
+      // Renderer's V8 sets console_output_disabled during initialization
+      // (before flags are frozen). Calling SetFlagsFromString at runtime
+      // crashes because V8 freezes flag memory after init.
+      auto cdp_root = base::JSONReader::ReadDict(
+          json_content, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+      if (cdp_root) {
+        const base::DictValue* cdp_fp = cdp_root->FindDict("cdp_fp");
+        if (cdp_fp && cdp_fp->FindBool("enabled").value_or(false)) {
+          command_line->AppendSwitchASCII(
+              "js-flags",
+              "--console_output_disabled,--debugger_keyword_disabled");
+          LOG(INFO) << "[Fingerprint] CDP evasion: passing --js-flags="
+                       "--console_output_disabled,--debugger_keyword_disabled "
+                       "to Renderer";
+        }
+      }
+    } else {
+      LOG(ERROR) << "[Fingerprint] Failed to read config file: "
+                 << config_path.value();
+    }
+  }
+
   if (IsForTopChromeWebUI()) {
     command_line->AppendSwitch(switches::kTopChromeWebUI);
   }
