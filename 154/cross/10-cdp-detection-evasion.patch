diff --git a/v8/src/parsing/parser-base.h b/v8/src/parsing/parser-base.h
index 54dde68..6e5aca8 100644
--- a/v8/src/parsing/parser-base.h
+++ b/v8/src/parsing/parser-base.h
@@ -6075,6 +6075,14 @@ ParserBase<Impl>::ParseDebuggerStatement() {
   int pos = peek_position();
   Consume(Token::kDebugger);
   ExpectSemicolon();
+  // ★ Infinite-debugger / CDP evasion: when enabled, `debugger` becomes an
+  // empty statement so anti-debugging "infinite debugger" loops cannot pause
+  // an attached DevTools. Must use EmptyStatement (a real no-op that parsing
+  // continues past), NOT NullStatement (nullptr), which ParseStatementList
+  // treats as a hard parse failure and aborts the whole statement list.
+  if (v8_flags.debugger_keyword_disabled) {
+    return factory()->EmptyStatement();
+  }
   return factory()->NewDebuggerStatement(pos);
 }
 
