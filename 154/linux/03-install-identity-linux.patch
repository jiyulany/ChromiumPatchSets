index 0000000000000..4e0adede8bae2
--- /dev/null
+++ b/chrome/browser/r0_license/install_identity_linux.cc
@@ -0,0 +1,133 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Linux implementation of the per-installation identity used by the r0 API
+// key lease protocol. The identity is a canonical (lowercase) UUID v4 stored
+// at ${XDG_DATA_HOME:-$HOME/.local/share}/r0browser/install-id-v2.dat with
+// file mode 0600 (owner read/write only).
+//
+// Unlike the Windows implementation (DPAPI) this offers no machine-bound
+// confidentiality: it only protects against other local users reading the
+// file. That is an accepted trade-off; see FRONTEND_INTEGRATION.md 26.8.6.
+
+#include "chrome/browser/r0_license/install_identity.h"
+
+#include <stdlib.h>
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/uuid.h"
+
+namespace r0_license {
+namespace {
+
+constexpr char kIdentityDirectory[] = "r0browser";
+constexpr char kIdentityFileBasename[] = "install-id-v2.dat";
+
+bool LooksLikeCanonicalUuid(const std::string& s) {
+  if (s.size() != 36) {
+    return false;
+  }
+  for (std::size_t i = 0; i < 36; ++i) {
+    char c = s[i];
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (c != '-') {
+        return false;
+      }
+      continue;
+    }
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::FilePath IdentityFilePath() {
+  // Prefer XDG_DATA_HOME per the XDG base directory spec; fall back to
+  // $HOME/.local/share the same way most desktop Linux software does.
+  const char* xdg_data_home = getenv("XDG_DATA_HOME");
+  if (xdg_data_home && xdg_data_home[0] != '\0') {
+    return base::FilePath(xdg_data_home)
+        .AppendASCII(kIdentityDirectory)
+        .AppendASCII(kIdentityFileBasename);
+  }
+  base::FilePath data_home;
+  if (base::PathService::Get(base::DIR_HOME, &data_home)) {
+    return data_home.Append(".local/share")
+        .AppendASCII(kIdentityDirectory)
+        .AppendASCII(kIdentityFileBasename);
+  }
+  return base::FilePath();
+}
+
+}  // namespace
+
+bool LoadOrCreateInstallId(std::string* install_id, std::string* error) {
+  if (!install_id) {
+    return false;
+  }
+  install_id->clear();
+
+  base::FilePath path = IdentityFilePath();
+  if (path.empty()) {
+    if (error) {
+      *error = "unable to resolve HOME directory";
+    }
+    return false;
+  }
+
+  if (base::PathExists(path)) {
+    std::string contents;
+    if (!base::ReadFileToString(path, &contents)) {
+      if (error) {
+        *error =
+            "install identity file is corrupted or unreadable; refusing to "
+            "silently generate a new device identity";
+      }
+      return false;
+    }
+    if (!LooksLikeCanonicalUuid(contents)) {
+      if (error) {
+        *error = "install identity file has unexpected format";
+      }
+      return false;
+    }
+    *install_id = contents;
+    return true;
+  }
+
+  base::Uuid uuid = base::Uuid::GenerateRandomV4();
+  std::string plaintext = uuid.AsLowercaseString();
+
+  if (!base::CreateDirectory(path.DirName())) {
+    if (error) {
+      *error = "unable to create identity directory";
+    }
+    return false;
+  }
+  if (!base::WriteFile(path, plaintext)) {
+    if (error) {
+      *error = "unable to persist new install identity";
+    }
+    return false;
+  }
+  // 0600: restrict to the owning user. Best effort — failure to tighten
+  // permissions is not fatal (the file only ever contains a random UUID,
+  // not a secret credential).
+  if (!base::SetPosixFilePermissions(
+          path, base::FILE_PERMISSION_READ_BY_USER |
+                   base::FILE_PERMISSION_WRITE_BY_USER)) {
+    LOG(WARNING) << "[r0_license] failed to chmod 0600 on "
+                 << path.value();
+  }
+  *install_id = plaintext;
+  return true;
+}
+
+}  // namespace r0_license
