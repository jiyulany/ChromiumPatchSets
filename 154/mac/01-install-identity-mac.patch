new file mode 100644
index 0000000000000..3a1ab36bf206b
--- /dev/null
+++ b/chrome/browser/r0_license/install_identity_mac.cc
@@ -0,0 +1,183 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// macOS implementation of the per-installation identity used by the r0 API
+// key lease protocol. Mirrors install_identity_win.cc semantics: the identity
+// is a canonical (lowercase) UUID v4, generated once and then bound to this
+// machine/user. Where Windows stores a DPAPI-protected v2 container on disk,
+// macOS stores the UUID as a Keychain generic-password item (service
+// "R0Browser", account "install-id-v2"), which provides the equivalent
+// machine/user-bound confidentiality through the login keychain.
+//
+// Pure C++ + Keychain C API on purpose (FRONTEND_INTEGRATION.md 26.8.5):
+// no Objective-C / Cocoa, so this stays a plain .cc file with no objc link
+// dependency.
+//
+// Shell verification:
+//   security find-generic-password -s "R0Browser" -a "install-id-v2" -w
+
+#ifdef UNSAFE_BUFFERS_BUILD
+// TODO(crbug.com/41496758): Convert pointer arithmetic to base::span.
+#pragma allow_unsafe_buffers
+#endif
+
+#include "chrome/browser/r0_license/install_identity.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <Security/Security.h>
+
+#include <string>
+
+#include "base/apple/scoped_cftyperef.h"
+#include "base/uuid.h"
+#include "chrome/browser/r0_license/r0_log.h"
+
+namespace r0_license {
+namespace {
+
+constexpr char kServiceName[] = "R0Browser";
+constexpr char kAccountName[] = "install-id-v2";
+
+// Canonical lowercase UUID: 8-4-4-4-12 hex. Same rule as the Windows and
+// Linux implementations.
+bool LooksLikeCanonicalUuid(const std::string& s) {
+  if (s.size() != 36) {
+    return false;
+  }
+  for (std::size_t i = 0; i < 36; ++i) {
+    char c = s[i];
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (c != '-') {
+        return false;
+      }
+      continue;
+    }
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::apple::ScopedCFTypeRef<CFStringRef> MakeCFString(const char* s) {
+  return base::apple::ScopedCFTypeRef<CFStringRef>(CFStringCreateWithCString(
+      kCFAllocatorDefault, s, kCFStringEncodingUTF8));
+}
+
+// Fills |plaintext| and returns true when the identity item exists. Returns
+// false when the item is absent (|*status| == errSecItemNotFound) or when the
+// Keychain lookup itself failed (locked keychain, access denied, ...); the
+// caller distinguishes the two cases via |*status|.
+bool LoadFromKeychain(std::string* plaintext, OSStatus* status) {
+  base::apple::ScopedCFTypeRef<CFStringRef> service =
+      MakeCFString(kServiceName);
+  base::apple::ScopedCFTypeRef<CFStringRef> account =
+      MakeCFString(kAccountName);
+  const void* keys[] = {kSecClass, kSecAttrService, kSecAttrAccount,
+                        kSecReturnData, kSecMatchLimit};
+  const void* values[] = {kSecClassGenericPassword, service.get(),
+                          account.get(), kCFBooleanTrue, kSecMatchLimitOne};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> query(CFDictionaryCreate(
+      kCFAllocatorDefault, keys, values, 5, &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks));
+
+  CFTypeRef result = nullptr;
+  *status = SecItemCopyMatching(query.get(), &result);
+  if (*status != errSecSuccess) {
+    return false;
+  }
+  base::apple::ScopedCFTypeRef<CFDataRef> data(
+      reinterpret_cast<CFDataRef>(result));
+  plaintext->assign(
+      reinterpret_cast<const char*>(CFDataGetBytePtr(data.get())),
+      static_cast<std::size_t>(CFDataGetLength(data.get())));
+  return true;
+}
+
+bool SaveToKeychain(const std::string& plaintext) {
+  base::apple::ScopedCFTypeRef<CFStringRef> service =
+      MakeCFString(kServiceName);
+  base::apple::ScopedCFTypeRef<CFStringRef> account =
+      MakeCFString(kAccountName);
+
+  // Best-effort delete so a retry never trips over errSecDuplicateItem.
+  const void* delete_keys[] = {kSecClass, kSecAttrService, kSecAttrAccount};
+  const void* delete_values[] = {kSecClassGenericPassword, service.get(),
+                                 account.get()};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> delete_query(
+      CFDictionaryCreate(kCFAllocatorDefault, delete_keys, delete_values, 3,
+                         &kCFTypeDictionaryKeyCallBacks,
+                         &kCFTypeDictionaryValueCallBacks));
+  SecItemDelete(delete_query.get());
+
+  base::apple::ScopedCFTypeRef<CFDataRef> value(
+      CFDataCreate(kCFAllocatorDefault,
+                   reinterpret_cast<const UInt8*>(plaintext.data()),
+                   static_cast<CFIndex>(plaintext.size())));
+  const void* add_keys[] = {kSecClass, kSecAttrService, kSecAttrAccount,
+                            kSecValueData, kSecAttrAccessible};
+  const void* add_values[] = {
+      kSecClassGenericPassword, service.get(), account.get(), value.get(),
+      // ThisDeviceOnly: the identity must never roam via iCloud Keychain;
+      // it is the server-side machine binding anchor (same role as DPAPI
+      // machine binding on Windows).
+      kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> add_query(CFDictionaryCreate(
+      kCFAllocatorDefault, add_keys, add_values, 5,
+      &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks));
+
+  OSStatus status = SecItemAdd(add_query.get(), nullptr);
+  if (status != errSecSuccess) {
+    R0_LOG(ERROR) << "[r0_license] SecItemAdd failed: " << status;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool LoadOrCreateInstallId(std::string* install_id, std::string* error) {
+  if (!install_id) {
+    return false;
+  }
+  install_id->clear();
+
+  std::string existing;
+  OSStatus status = errSecSuccess;
+  if (LoadFromKeychain(&existing, &status)) {
+    if (!LooksLikeCanonicalUuid(existing)) {
+      if (error) {
+        *error = "install identity keychain item has unexpected format";
+      }
+      return false;
+    }
+    *install_id = existing;
+    return true;
+  }
+  if (status != errSecItemNotFound) {
+    // Same fail-closed policy as the Windows implementation: a
+    // present-but-unreadable identity must never be silently replaced with a
+    // fresh one (that would inflate the active instance count server-side).
+    R0_LOG(ERROR) << "[r0_license] SecItemCopyMatching failed: " << status;
+    if (error) {
+      *error =
+          "install identity keychain item is unreadable; refusing to "
+          "silently generate a new device identity";
+    }
+    return false;
+  }
+
+  base::Uuid uuid = base::Uuid::GenerateRandomV4();
+  std::string plaintext = uuid.AsLowercaseString();
+  if (!SaveToKeychain(plaintext)) {
+    if (error) {
+      *error = "unable to persist new install identity to Keychain";
+    }
+    return false;
+  }
+  *install_id = plaintext;
+  return true;
+}
+
+}  // namespace r0_license
