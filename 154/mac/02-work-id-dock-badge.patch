+- (void)drawWorkerBadge {
+  if (_workerId <= 0) {
+    return;
+  }
+
+  NSString* text = @(_workerId).stringValue;
+  const CGFloat badgeHeight = NSHeight(self.bounds) * 0.28;
+  const CGFloat padding = badgeHeight * 0.30;
+  NSFont* font = [NSFont boldSystemFontOfSize:badgeHeight * 0.62];
+  NSDictionary* attributes = @{
+    NSFontAttributeName : font,
+    NSForegroundColorAttributeName : NSColor.whiteColor,
+  };
+  const NSSize textSize = [text sizeWithAttributes:attributes];
+  const CGFloat badgeWidth = MAX(badgeHeight, textSize.width + 2 * padding);
+  const CGFloat margin = NSWidth(self.bounds) * 0.03;
+  const NSRect badgeRect =
+      NSMakeRect(NSMaxX(self.bounds) - badgeWidth - margin,
+                 NSMaxY(self.bounds) - badgeHeight - margin, badgeWidth,
+                 badgeHeight);
+
+  [NSColor.whiteColor setFill];
+  [[NSBezierPath bezierPathWithRoundedRect:badgeRect
+                                   xRadius:badgeHeight / 2
+                                   yRadius:badgeHeight / 2] fill];
+
+  const NSRect innerRect = NSInsetRect(badgeRect, 1.5, 1.5);
+  [[NSColor colorWithCalibratedRed:0x26 / 255.0
+                             green:0x25 / 255.0
+                              blue:0x2d / 255.0
+                             alpha:1] setFill];
+  [[NSBezierPath bezierPathWithRoundedRect:innerRect
+                                   xRadius:NSHeight(innerRect) / 2
+                                   yRadius:NSHeight(innerRect) / 2] fill];
+
+  [text drawAtPoint:NSMakePoint(NSMidX(badgeRect) - textSize.width / 2,
+                                NSMidY(badgeRect) - textSize.height / 2)
+      withAttributes:attributes];
+}
 
