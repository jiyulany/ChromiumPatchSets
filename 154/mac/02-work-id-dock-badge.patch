+int GetWorkerBadgeId() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  std::string value;
+  if (command_line->HasSwitch("work-id")) {
+    value = command_line->GetSwitchValueASCII("work-id");
+  } else if (command_line->HasSwitch("worker-id")) {
+    value = command_line->GetSwitchValueASCII("worker-id");
+  } else {
+    return 0;
+  }
+
+  int worker_id = 0;
+  if (!base::StringToInt(value, &worker_id) || worker_id < 1 ||
+      worker_id > 999) {
+    return 0;
+  }
+  return worker_id;
+}
