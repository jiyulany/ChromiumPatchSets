+// Returns false when the file cannot be decrypted in either format.
+// |legacy_format| is set to true when the file is the old Chromium-only
+// bare-DPAPI container (no magic, no entropy); the caller migrates it.
+bool DecryptFromFile(const base::FilePath& path, std::string* plaintext,
+                     bool* legacy_format) {
+  std::string bytes;
+  if (!base::ReadFileToString(path, &bytes)) return false;
+
+  if (bytes.size() > kMagic.size() &&
+      std::equal(kMagic.begin(), kMagic.end(), bytes.begin())) {
+    // Shared v2 container (auth-shell compatible).
+    *legacy_format = false;
+    return DpapiDecrypt(bytes.substr(kMagic.size()), true, plaintext);
+  }
+
+  // Legacy Chromium-only format: the whole file is a bare DPAPI blob with
+  // no entropy. Kept readable for a smooth one-time migration.
+  *legacy_format = true;
+  return DpapiDecrypt(bytes, false, plaintext);
+}
