+namespace {
+
+constexpr int kWorkerIconSize = 48;
+
+int GetWorkerIconId() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("worker-id")) {
+    return 0;
+  }
+  int worker_id = 0;
+  if (!base::StringToInt(command_line->GetSwitchValueASCII("worker-id"),
+                         &worker_id) ||
+      worker_id < 1 || worker_id > 999) {
+    return 0;
+  }
+  return worker_id;
+}
+
+SkBitmap CreateWorkerBadgedIcon(const SkBitmap& base_icon, int worker_id) {
+  SkBitmap icon;
+  icon.allocN32Pixels(kWorkerIconSize, kWorkerIconSize);
+  SkCanvas canvas(icon, skia::LegacyDisplayGlobals::GetSkSurfaceProps());
+  canvas.clear(SK_ColorTRANSPARENT);
+  canvas.drawImageRect(base_icon.asImage(),
+                       SkRect::MakeWH(kWorkerIconSize, kWorkerIconSize),
+                       SkSamplingOptions());
+
+  // One digit uses a circle; wider values use a capsule so three digits do
+  // not have to be shrunk into a small circular badge.
+  const std::string text = base::NumberToString(worker_id);
+  const float badge_width =
+      text.size() == 1 ? 24.0f : (text.size() == 2 ? 29.0f : 34.0f);
+  const SkRect badge_bounds =
+      SkRect::MakeLTRB(47.0f - badge_width, 1.0f, 47.0f, 25.0f);
+  SkPaint paint;
+  paint.setAntiAlias(true);
+  paint.setColor(SK_ColorWHITE);
+  canvas.drawRoundRect(badge_bounds, 12.0f, 12.0f, paint);
+  SkRect inner_bounds = badge_bounds;
+  inner_bounds.inset(1.5f, 1.5f);
+  paint.setColor(SkColorSetRGB(0x26, 0x25, 0x2D));
+  canvas.drawRoundRect(inner_bounds, 10.5f, 10.5f, paint);
+
+  SkFont font = skia::DefaultFont();
+  font.setEmbolden(true);
+  SkRect bounds;
+  int text_size = 20;
+  const float max_text_width = badge_width - 6.0f;
+  do {
+    font.setSize(text_size--);
+    font.measureText(text.c_str(), text.size(), SkTextEncoding::kUTF8,
+                     &bounds);
+  } while (text_size >= 9 &&
+           (bounds.width() > max_text_width || bounds.height() > 18.0f));
+
+  paint.reset();
+  paint.setAntiAlias(true);
+  paint.setColor(SK_ColorWHITE);
+  canvas.drawSimpleText(
+      text.c_str(), text.size(), SkTextEncoding::kUTF8,
+      badge_bounds.centerX() - bounds.width() / 2 - bounds.x(),
+      badge_bounds.centerY() - bounds.height() / 2 - bounds.y(), font,
+      paint);
+  return icon;
+}
